#include <windows.h>
#include "resource.h"

IDI_OPENYR ICON "openyr-setup.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenYR"
            VALUE "FileDescription", "OpenYR setup"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "OpenYR-Setup"
            VALUE "OriginalFilename", "OpenYR-Setup.exe"
            VALUE "ProductName", "OpenYR"
            VALUE "ProductVersion", "0.2.0"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
