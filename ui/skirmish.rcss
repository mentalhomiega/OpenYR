/* The player list stands on the left and the map and its settings on the right. The size
   below fits the classic style's 800x600; the modern style widens the panel and the list. */

#reveal
{
	width: 780dp;
	height: 472dp;
	top: 50%;
	margin-top: -236dp;
}

#content
{
	padding: 14dp 14dp 0 14dp;
}

#columns
{
	display: flex;
}

#left
{
	width: 484dp;
	margin-right: 14dp;
}

#right
{
	width: 254dp;
}

/* The player list */
#players
{
	padding: 6dp 6dp 4dp 6dp;
}

#headings, .slot
{
	display: flex;
	align-items: center;
}

#headings
{
	height: 20dp;
}

#headings > .caption
{
	display: block;
	height: 20dp;
	line-height: 20dp;
}

.slot
{
	height: 34dp;
}

.col-player { width: 132dp; margin-right: 6dp; }
.col-side { width: 104dp; margin-right: 6dp; }
.col-color { width: 104dp; margin-right: 6dp; }
.col-start { width: 68dp; margin-right: 6dp; }
.col-team { width: 60dp; margin-right: 0; }

.cell
{
	display: flex;
	align-items: center;
	height: 28dp;
}

.cell > .pick, .cell > .handle
{
	flex: 1;
	margin: 0;
	min-width: 0;
}

.cell > .handle
{
	height: 18dp;
	margin-right: 2dp;
}

.chip
{
	display: block;
	flex: none;
	width: 12dp;
	height: 16dp;
	margin-right: 4dp;
	border: 1dp #00000099;
}

.slot.off .chip
{
	opacity: 0.35;
}

/* A seat nobody plays fades, so the seats in use stand out. */
.slot.off .cell > select
{
	opacity: 0.55;
}

/* What the game is played with */
#switches
{
	margin-top: 8dp;
	padding: 8dp 8dp 4dp 8dp;
}

#switches > label.check
{
	display: inline-block;
	width: 50%;
	margin-bottom: 1dp;
}

/* The map */
#map
{
	position: relative;
	width: 254dp;
	height: 136dp;
}

#preview
{
	position: absolute;
	left: -1dp;
	top: -1dp;
	width: 252dp;
	height: 134dp;
}

#preview-caption
{
	position: absolute;
	left: -1dp;
	top: 54dp;
	width: 252dp;
	height: 22dp;
	line-height: 17dp;
	text-align: center;
}

/* The map picture covers the caption, as it did in the original dialog. */
#preview.filled + #preview-caption
{
	display: none;
}

#mapname
{
	display: block;
	width: 254dp;
	height: 18dp;
	margin-top: 5dp;
	line-height: 17dp;
	overflow: hidden;
}

#pick
{
	width: 254dp;
	margin-top: 4dp;
}

#settings
{
	width: 254dp;
	margin-top: 8dp;
	padding: 6dp 0 2dp 8dp;
}

.setting
{
	height: 46dp;
}

.setting > .caption
{
	display: block;
	height: 14dp;
	line-height: 17dp;
}

.setting > .row
{
	height: 24dp;
	margin-top: 4dp;
	white-space: nowrap;
}

.setting input[type='range']
{
	width: 150dp;
	height: 23dp;
}

.setting .trough, .setting .trough-edge
{
	height: 24dp;
}

.setting .trough
{
	line-height: 23dp;
}

#notice
{
	display: block;
	height: 16dp;
	margin-top: 6dp;
	line-height: 16dp;
	color: #ffcc66;
}

#buttons
{
	display: flex;
	margin-top: 4dp;
}

#ok
{
	width: 120dp;
	margin-right: 14dp;
}

#cancel
{
	width: 120dp;
}
