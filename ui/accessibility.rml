<rml>
<head>
	<title>Accessibility options</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="settings.rcss"/>
	<link type="text/rcss" href="display.rcss"/>
</head>
<body template="dialog" class="page-settings settings-backdrop" data-model="accessibility">
	<div id="page">
		<div id="list">
			<p class="section">Colour</p>
			<div class="setting" id="colorblind-row" desc="Shifts colours so they stay distinct for the chosen kind of colour blindness."><span class="caption">Colour-blind mode</span><select id="colorblind" data-value="colorblindmode" data-event-change="queue('colorblindmode', ev.value)">
				<option data-for="entry : colorblindmodes" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<div class="setting slider-row" id="colorblind-strength-row" desc="How strongly the colour-blind correction applies. 100% is the full correction."><span class="caption">Strength</span><input type="range" id="colorblind-strength" min="0" max="100" step="5" data-attr-value="colorblindstrength" data-event-change="queue('colorblindstrength', ev.value)"/><span class="value" id="colorblind-strength-value">{{colorblindstrength}}%</span></div>
			<div class="setting" id="player-colors-row" desc="How player colours are drawn. Colour-blind safe uses colours that are easier to tell apart."><span class="caption">Player colors</span><select id="player-colors" data-value="playercolors" data-event-change="queue('playercolors', ev.value)">
				<option data-for="entry : playercolorchoices" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>

			<p class="section">Effects</p>
			<label class="check setting" id="switch-shake" desc="Shakes the screen during heavy fire and explosions. Off keeps the picture still."><span class="caption">Screen shake</span><input type="checkbox" id="shake" data-attrif-checked="screenshake" data-event-click="queue('screenshake', screenshake ? 0 : 1)"/></label>
			<label class="check setting" id="switch-scripted-zoom" desc="Scripted scenes zoom the map to one height whatever zoom the player picked, and the player's zoom returns afterward. Off leaves the zoom alone."><span class="caption">Cinematic zoom for scripted scenes</span><input type="checkbox" id="scripted-zoom" data-attrif-checked="scriptedzoom" data-event-click="queue('scriptedzoom', scriptedzoom ? 0 : 1)"/></label>
		</div>
		<div id="side">
			<p id="side-title">Description</p>
			<p id="description">Point at a setting or select it to read what it does.</p>
			<p class="side-note">Colour-blind changes show on the whole screen while this page is open. Cancel puts the old values back.</p>
		</div>
	</div>
	<div id="footer">
		<button id="footer-reset" class="big" data-event-click="queue('reset')">Reset to defaults</button>
		<span id="footer-spacer"></span>
		<button id="footer-cancel" class="big" data-event-click="queue('cancel')">Back</button>
		<button id="footer-ok" class="big primary" data-event-click="queue('ok')">[[TXT_OK]]</button>
	</div>
</body>
</rml>
