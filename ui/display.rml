<rml>
<head>
	<title>Display options</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="display.rcss"/>
	<link type="text/rcss" href="setting-preview.rcss"/>
</head>
<body template="dialog" data-model="display">
	<p class="heading" id="title">Display Options:</p>
	<div id="columns">
		<div id="left">
			<p class="heading" id="modes-label">Resolution Modes</p>
			<div id="modes-row"><div id="modes" class="list"><div class="rows">
				<div class="item" data-for="mode : modes" data-class-selected="it_index == selected" data-event-click="queue('select', it_index)">{{mode.label}}</div>
			</div></div>
				<div id="panel-preview" class="setting-preview" data-class-disabled="!moderninterface"><p class="setting-preview-caption">{{preview.caption}}</p><div data-for="shape : preview.shapes" data-attr-class="shape.classes" data-style-left="shape.left" data-style-top="shape.top" data-style-width="shape.width" data-style-height="shape.height"></div></div></div>
			<div class="row" id="scale-row"><span class="caption">Interface scale:</span><select id="scale" data-value="scale" data-event-change="queue('scale', ev.value)">
				<option data-for="entry : scales" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<label class="check" id="switch-stretch"><input type="checkbox" id="stretch" data-attrif-checked="stretch" data-event-click="queue('stretch', stretch ? 0 : 1)"/>Stretch movies to fit resolution</label>
			<label class="check" id="switch-classic-menus"><input type="checkbox" id="classic-menus" data-attrif-checked="classicmenus" data-event-click="queue('classicmenus', classicmenus ? 0 : 1)"/>Classic Yuri's Revenge menus</label>
			<label class="check" id="switch-modern-interface"><input type="checkbox" id="modern-interface" data-attrif-checked="moderninterface" data-event-click="queue('moderninterface', moderninterface ? 0 : 1)"/>Modern in-game interface</label>
			<div class="row" id="rows-row" data-class-disabled="!moderninterface"><span class="caption">Sidebar rows:</span><select id="sidebar-rows" data-value="rowcount" data-attrif-disabled="!moderninterface" data-event-change="queue('sidebarrows', ev.value)">
				<option data-for="entry : rowcounts" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<label class="check" id="switch-debug-mode"><input type="checkbox" id="debug-mode" data-attrif-checked="debugmode" data-event-click="queue('debugmode', debugmode ? 0 : 1)"/>Debug mode (for testing)</label>
			<div class="row" id="hdr-row" data-attr-tip="hdroutputtip"><span class="caption">HDR:</span><select id="hdr" data-value="hdroutput" data-event-change="queue('hdroutput', ev.value)">
				<option data-for="entry : hdroutputs" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
		</div>
		<div id="right">
			<p class="heading" id="window-label">Window</p>
			<label class="check" id="switch-fullscreen"><input type="checkbox" id="fullscreen" data-attrif-checked="fullscreen" data-event-click="queue('fullscreen', fullscreen ? 0 : 1)"/>Full screen</label>
			<label class="check" id="switch-vsync"><input type="checkbox" id="vsync" data-attrif-checked="vsync" data-event-click="queue('vsync', vsync ? 0 : 1)"/>Wait for vertical sync</label>
			<label class="check" id="switch-integer-scaling"><input type="checkbox" id="integer-scaling" data-attrif-checked="integerscaling" data-event-click="queue('integerscaling', integerscaling ? 0 : 1)"/>Scale by whole steps only</label>
			<div class="row" id="filter-row"><span class="caption">Scaling filter:</span><select id="filter" data-value="filter" data-event-change="queue('filter', ev.value)">
				<option data-for="entry : filters" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<div class="row"><span class="caption">Smooth motion:</span><select id="framerate" data-value="framerate" data-event-change="queue('framerate', ev.value)">
				<option data-for="entry : framerates" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<div class="row" id="highlights-row" data-attr-tip="highlightstip" data-class-disabled="!hdractive"><span class="caption">Highlights:</span><select id="highlights" data-value="highlights" data-attrif-disabled="!hdractive" data-event-change="queue('highlights', ev.value)">
				<option value="0">Classic</option>
				<option value="1">Enhanced</option>
			</select></div>
			<p class="heading" id="pointer-label">Mouse Pointer</p>
			<label class="check" id="switch-system-cursor"><input type="checkbox" id="system-cursor" data-attrif-checked="systemcursor" data-event-click="queue('systemcursor', systemcursor ? 0 : 1)"/>Use the system mouse pointer</label>
			<div class="row"><span class="caption">Pointer size:</span><select id="cursorscale" data-value="cursorscale" data-event-change="queue('cursorscale', ev.value)">
				<option data-for="entry : cursorscales" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<p class="heading" id="renderer-label">Renderer</p>
			<div class="row"><span class="caption">Graphics API:</span><select id="renderer" data-value="renderer" data-event-change="queue('renderer', ev.value)">
				<option data-for="entry : renderers" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<div class="row slider-row" id="paper-row"><span class="caption">Paper white</span><input type="range" id="paper-white" min="80" max="480" step="10" data-attr-value="paperwhite" data-event-change="queue('paperwhite', ev.value)"/><span class="value" id="paper-value">{{paperwhite}} nits</span></div>
			<div class="row slider-row" id="peak-row"><span class="caption">Peak brightness</span><input type="range" id="peak-brightness" min="80" max="10000" step="10" data-attr-value="peakbrightness" data-event-change="queue('peak', ev.value)"/><span class="value" id="peak-value">{{peakbrightness}} nits</span></div>
			<p class="heading" id="colour-label">Colour</p>
			<div class="row" id="colorblind-row"><span class="caption">Colour-blind mode:</span><select id="colorblind" data-value="colorblindmode" data-event-change="queue('colorblindmode', ev.value)">
				<option data-for="entry : colorblindmodes" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<div class="row slider-row" id="colorblind-strength-row"><span class="caption">Strength</span><input type="range" id="colorblind-strength" min="0" max="100" step="5" data-attr-value="colorblindstrength" data-event-change="queue('colorblindstrength', ev.value)"/><span class="value" id="colorblind-strength-value">{{colorblindstrength}}%</span></div>
		</div>
	</div>
	<div id="buttons">
		<button id="ok" data-event-click="queue('ok')">[[TXT_OK]]</button>
		<button id="cancel" data-event-click="queue('cancel')">[[TXT_CANCEL]]</button>
	</div>
</body>
</rml>
