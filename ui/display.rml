<rml>
<head>
	<title>Display options</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="settings.rcss"/>
	<link type="text/rcss" href="display.rcss"/>
</head>
<body template="dialog" class="page-settings settings-backdrop" data-model="display">
	<div id="page">
		<div id="list">
			<p class="section">Screen</p>
			<div class="setting" id="modes-select-row" desc="The screen size the game switches to. You are asked to keep it before it stays."><span class="caption">Resolution</span><select id="modes-select" data-value="selected" data-event-change="queue('select', ev.value)">
				<option data-for="mode : modes" data-attr-value="it_index">{{mode.label}}</option>
			</select></div>
			<div class="setting tall" id="modes-row" desc="The screen size the game switches to. You are asked to keep it before it stays."><span class="caption">Resolution</span><div id="modes" class="list"><div class="rows">
				<div class="item" data-for="mode : modes" data-class-selected="it_index == selected" data-event-click="queue('select', it_index)">{{mode.label}}</div>
			</div></div></div>
			<div class="setting" id="scale-row" desc="The size of the menus and in-game panels. Automatic picks one that fits the screen."><span class="caption">UI scale</span><select id="scale" data-value="scale" data-event-change="queue('scale', ev.value)">
				<option data-for="entry : scales" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<div class="setting" id="windowsize-row" desc="The size of the game window when it is not fullscreen. Match resolution uses the screen size."><span class="caption">Window size</span><select id="windowsize" data-value="windowsize" data-event-change="queue('windowsize', ev.value)">
				<option data-for="entry : windowsizes" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>

			<p class="section">Window</p>
			<label class="check setting" id="switch-fullscreen" desc="Fills the screen with a borderless window. Off runs the game in a window."><span class="caption">Fullscreen</span><input type="checkbox" id="fullscreen" data-attrif-checked="fullscreen" data-event-click="queue('fullscreen', fullscreen ? 0 : 1)"/></label>
			<label class="check setting" id="switch-vsync" desc="Waits for the screen to refresh before it draws a frame, which stops tearing. It can add a little delay."><span class="caption">V-Sync</span><input type="checkbox" id="vsync" data-attrif-checked="vsync" data-event-click="queue('vsync', vsync ? 0 : 1)"/></label>
			<div class="setting" id="framelimit-row" desc="The most frames a second the game draws. Off leaves the rate uncapped."><span class="caption">Frame rate limit</span><select id="framelimit" data-value="framelimit" data-event-change="queue('framelimit', ev.value)">
				<option data-for="entry : framelimits" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<label class="check setting" id="switch-show-fps" desc="Shows the frames drawn each second in the corner of the screen."><span class="caption">Show FPS</span><input type="checkbox" id="show-fps" data-attrif-checked="showfps" data-event-click="queue('showfps', showfps ? 0 : 1)"/></label>

			<p class="section">Mouse pointer</p>
			<label class="check setting" id="switch-system-cursor" desc="Uses the pointer Windows draws, instead of the one the game draws."><span class="caption">Use the Windows pointer</span><input type="checkbox" id="system-cursor" data-attrif-checked="systemcursor" data-event-click="queue('systemcursor', systemcursor ? 0 : 1)"/></label>
			<div class="setting" id="cursorscale-row" desc="The size of the pointer the game draws."><span class="caption">Cursor size</span><select id="cursorscale" data-value="cursorscale" data-event-change="queue('cursorscale', ev.value)">
				<option data-for="entry : cursorscales" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<div class="setting" id="menutheme-row" desc="The colour of the menus: Allied blue, Soviet red or Yuri purple. Random picks one at each start. The change takes effect when you press OK."><span class="caption">Menu theme</span><select id="menutheme" data-value="menutheme" data-event-change="queue('menutheme', ev.value)">
				<option data-for="entry : menuthemes" data-attr-value="it_index">{{entry.label}}</option>
			</select></div>
			<label class="check setting" id="switch-menu-battle" desc="Plays a computer battle behind the modern menus, in place of the title art. It stops when a game starts."><span class="caption">Battle behind the menus</span><input type="checkbox" id="menu-battle" data-attrif-checked="menubattle" data-event-click="queue('menubattle', menubattle ? 0 : 1)"/></label>
		</div>
		<div id="side">
			<p id="side-title">Description</p>
			<p id="description">Point at a setting or select it to read what it does.</p>
		</div>
	</div>
	<div id="footer">
		<button id="footer-reset" class="big" data-event-click="queue('reset')">Reset to defaults</button>
		<span id="footer-spacer"></span>
		<button id="footer-cancel" class="big" data-event-click="queue('cancel')">Back</button>
		<button id="footer-ok" class="big primary" data-event-click="queue('ok')">[[TXT_OK]]</button>
	</div>
</body>
</rml>
