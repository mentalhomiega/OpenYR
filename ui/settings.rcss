/* The layout of the settings pages: the Game, Display, Graphics, Audio, Controls, Accessibility and Mods
   screens. The tab column runs down the left (theme.rcss styles it), and each page fills the rest of the
   window. Its settings lie in two columns, each label above its control; a section heading is a strip across
   both columns. The description panel stands at the right, and the footer holds Reset to defaults at the left
   and Back and OK at the right. Sizes are in dp. */

/* The page fills the window, to the right of the tab column when the page is one of the tabbed Settings. */
.page-settings #reveal
{
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	width: auto;
	height: auto;
	margin: 0;
}

.settings.page-settings #reveal
{
	left: 200dp;
}

/* The chrome takes the reveal's height, so the footer stays at its bottom edge. */
.page-settings #chrome
{
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	height: auto;
	display: flex;
	flex-direction: column;
}

.page-settings #content
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0px;
	min-height: 0;
	padding: 0;
}

.page-settings #page
{
	display: flex;
	flex: 1 1 0px;
	min-height: 0;
}

/* The list of settings: its rows wrap into two columns, and a section heading takes a full row. */
.page-settings #list
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	flex: 1 1 0px;
	min-width: 0;
	min-height: 0;
	overflow-y: auto;
	padding: 10dp 18dp 18dp 18dp;
}

.page-settings #side
{
	display: flex;
	flex-direction: column;
	flex: 0 0 300dp;
	min-height: 0;
	overflow-y: auto;
	padding: 18dp 20dp 18dp 16dp;
}

.page-settings #footer
{
	display: flex;
	flex: 0 0 auto;
	align-items: center;
	height: 56dp;
	padding: 0 16dp;
}

.page-settings #footer button
{
	width: 150dp;
	height: 34dp;
	margin-left: 10dp;
}

.page-settings #footer #footer-reset
{
	margin-left: 0;
	width: 180dp;
}

.page-settings #footer-spacer
{
	flex: 1 1 auto;
}

/* A group of settings that sits in the list as one block takes the full width, so its own rows wrap inside it. */
.page-settings #extras, .page-settings #music, .page-settings #buttons
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	width: 100%;
	box-sizing: border-box;
}

/* A section heading: a thin strip across both columns with its title centred. */
.page-settings .section
{
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 28dp;
	margin: 14dp 0 10dp 0;
	padding: 0 8dp;
	line-height: 28dp;
	text-align: center;
	font-size: 15dp;
	background-color: #1d1730b8;
	border-top: 1dp #4d3d6b;
	border-bottom: 1dp #4d3d6b;
}

.page-settings .section:first-child
{
	margin-top: 0;
}

/* One setting: its label sits on the first line and its control below it. */
.page-settings .setting
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	box-sizing: border-box;
	width: 47%;
	min-height: 0;
	margin: 0 3% 10dp 0;
	padding: 4dp 8dp;
	border-radius: 4dp;
}

.page-settings .setting:hover
{
	background-color: #ffffff0f;
}

.page-settings .setting > .caption
{
	flex: 0 0 100%;
	width: 100%;
	line-height: 20dp;
	white-space: nowrap;
}

.page-settings .setting > select
{
	width: 240dp;
	height: 28dp;
	margin: 4dp 0 0 0;
}

.page-settings .setting > input[type='range']
{
	width: 200dp;
	height: 24dp;
	margin: 4dp 8dp 0 0;
}

.page-settings .setting > .value
{
	width: 64dp;
	margin-top: 4dp;
	line-height: 24dp;
	text-align: left;
}

/* A switch is a label with its check box under the caption. */
.page-settings label.check.setting
{
	display: flex;
	min-height: 0;
	line-height: 20dp;
}

.page-settings label.check.setting > input[type='checkbox']
{
	margin: 4dp 0 0 0;
}

/* A setting that cannot be changed right now shows its label greyed. */
.page-settings .setting.disabled > .caption
{
	color: #6a6388;
}

/* A list that a setting holds, such as the resolutions, takes the full width of its row. */
.page-settings .setting.tall
{
	width: 100%;
	margin-right: 0;
}

.page-settings .setting.tall > .list
{
	width: 100%;
	height: 130dp;
	margin-top: 4dp;
}

/* The description panel. It shows the text of the setting the pointer or the focus is on. */
.page-settings #side-title
{
	margin: 0 0 8dp 0;
	line-height: 22dp;
	font-size: 17dp;
}

.page-settings #description
{
	line-height: 20dp;
}

.page-settings .side-note
{
	margin-top: 14dp;
	line-height: 18dp;
}
