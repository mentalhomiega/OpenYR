/* The classic menu style: Yuri's Revenge's own menu screen and dialog art. Sizes are in dp,
   laid out for 800x600; the stage is centred in the window and scales with it. */

body
{
	color: #e8dcff;
}

@spritesheet title
{
	src: Title.PCX;
	title-column: 472px 0px 168px 448px;
	title-bar: 0px 448px 472px 32px;
}

/* The menu screen behind every menu; over a game in progress the game shows instead. */
#screen-bg
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: -2;
	background-color: #000000;
	pointer-events: none;
}

#stage
{
	position: absolute;
	left: 50%;
	top: 50%;
	width: 800dp;
	height: 600dp;
	margin-left: -400dp;
	margin-top: -300dp;
}

#stage-art
{
	position: absolute;
	left: 0;
	top: 0;
	width: 632dp;
	height: 568dp;
	decorator: image(GLSLMD.SHP@GLSMD.PAL cover left top);
}

#stage-column
{
	position: absolute;
	left: 632dp;
	top: 0;
	width: 168dp;
	height: 568dp;
	decorator: image(title-column fill);
}

#stage-bar
{
	position: absolute;
	left: 0;
	top: 568dp;
	width: 800dp;
	height: 32dp;
	decorator: image(title-bar fill);
}

.ingame #screen-bg
{
	display: none;
}

/* Dialogs sit on Yuri's Revenge's dialog backdrop in Yuri's colours. */
#bar-left, #bar-right, #edge-left, #edge-right, #glow, #wallpaper-art,
.revealing #edge-left, .revealing #edge-right
{
	display: none;
}

/* Yuri's Revenge's dialog backdrops are read only once a game is under way, so the dialogs
   take a plain backdrop in the same colours. */
#wallpaper
{
	background-color: #0a0612;
	decorator: vertical-gradient(#24163cf0 #07040cf0);
	border: 2dp #7d5cb8;
}

/* The main menu and the menus it opens stand in the right-hand column at Yuri's Revenge's places:
   the menu's name across the top, the buttons from about a third of the way down, and the
   button that leaves at the foot of the column. The options menu keeps its own panel. */
body.main #backdrop #reveal, body.singleplayer #backdrop #reveal, body.movies #backdrop #reveal, body.multiplayer #backdrop #reveal
{
	position: absolute;
	left: 50%;
	top: 50%;
	width: 168dp;
	height: 600dp;
	margin-left: 232dp;
	margin-top: -300dp;
}

body.main #content, body.singleplayer #content, body.movies #content
{
	position: relative;
	padding: 0;
}

body.main #wallpaper, body.singleplayer #wallpaper, body.movies #wallpaper, body.multiplayer #wallpaper
{
	background-color: transparent;
	decorator: none;
	border-width: 0;
}

body.main #title, body.singleplayer #title, body.movies #title, body.multiplayer #title
{
	display: block;
	position: absolute;
	left: 0;
	top: 2dp;
	width: 168dp;
	height: 16dp;
	line-height: 16dp;
	text-align: center;
}

body.main #content button, body.singleplayer #content button, body.movies #content button, body.multiplayer #content button
{
	position: absolute;
	margin: 0;
	left: 3dp;
	width: 162dp;
	height: 37dp;
	padding-top: 11dp;
}

body.main #content button:nth-child(1), body.singleplayer #content button:nth-child(1), body.movies #content button:nth-child(1) { top: 203dp; }
body.main #content button:nth-child(2), body.singleplayer #content button:nth-child(2), body.movies #content button:nth-child(2) { top: 247dp; }
body.main #content button:nth-child(3), body.singleplayer #content button:nth-child(3), body.movies #content button:nth-child(3) { top: 291dp; }
body.main #content button:nth-child(4), body.singleplayer #content button:nth-child(4), body.movies #content button:nth-child(4) { top: 335dp; }
body.main #content button:nth-child(5), body.singleplayer #content button:nth-child(5), body.movies #content button:nth-child(5) { top: 379dp; }
body.singleplayer #content button:nth-child(1), body.movies #content button:nth-child(1) { top: 198dp; }
body.singleplayer #content button:nth-child(2), body.movies #content button:nth-child(2) { top: 242dp; }
body.singleplayer #content button:nth-child(3), body.movies #content button:nth-child(3) { top: 286dp; }
body.main #content button:nth-child(6) { top: 423dp; }
body.main #content button:nth-child(7) { top: 537dp; }
body.singleplayer #content button:nth-child(4), body.movies #content button:nth-child(4) { top: 563dp; }

body.multiplayer #content button:nth-child(1) { top: 203dp; }
body.multiplayer #content button:nth-child(2) { top: 247dp; }
body.multiplayer #content button:nth-child(3) { top: 291dp; }
body.multiplayer #content button:nth-child(4) { top: 563dp; }

body.main #content button:active, body.singleplayer #content button:active, body.movies #content button:active, body.multiplayer #content button:active
{
	padding-top: 12dp;
}

/* Buttons are Yuri's Revenge's menu button in its three states. */
button, button.wide, button.tall
{
	height: 25dp;
	border-width: 0;
	padding: 5dp 4dp 0 4dp;
	color: #e8dcff;
	background-color: transparent;
	decorator: image(MNBTTN.SHP@DIALOGY.PAL@0 fill);
}

button:hover, button.wide:hover, button.tall:hover
{
	color: #ffffff;
	decorator: image(MNBTTN.SHP@DIALOGY.PAL@1 fill);
}

button:active, button.wide:active, button.tall:active
{
	position: relative;
	top: 0;
	border-width: 0;
	padding: 6dp 4dp 0 4dp;
	color: #ffffff;
	decorator: image(MNBTTN.SHP@DIALOGY.PAL@2 fill);
}

button.disabled, button:disabled, button.wide.disabled, button.wide:disabled, button.tall.disabled, button.tall:disabled,
button.disabled:active, button:disabled:active, button.wide.disabled:active, button.wide:disabled:active,
button.tall.disabled:active, button.tall:disabled:active
{
	position: relative;
	top: 0;
	border-width: 0;
	padding: 5dp 4dp 0 4dp;
	color: #6c6080;
	decorator: image(MNBTTN.SHP@DIALOGY.PAL@0 fill);
}

/* Fields and lists */
input[type='range'], input[type='text'], input[type='password'], textarea, select, .hotkey, .list
{
	border-color: #8a6cc4;
	background-color: #000000c0;
}

.list .item, select option
{
	color: #e8dcff;
}

.list .item:checked, .list .item.selected, select option:checked
{
	background-color: #5a3c8c;
	color: #ffffff;
}

.caption, .value
{
	color: #f0e6ff;
}

.tooltip
{
	background-color: #000000e0;
	border: 1dp #8a6cc4;
	color: #e8dcff;
}

/* Fields and value boxes in Yuri's colours. */
input[type='text'], input[type='password'], textarea, .hotkey, select, select option
{
	color: #e8dcff;
	caret-color: #e8dcff;
}

input selection, textarea selection
{
	background-color: #5a3c8c;
	color: #ffffff;
}

.trough, .trough.disabled
{
	border: 1dp #8a6cc4;
	background-color: #000000c0;
	color: #e8dcff;
	decorator: none;
}

.trough-edge, .trough-edge.disabled
{
	background-color: transparent;
}

.frame, .group, progress, select selectbox
{
	border-color: #8a6cc4;
}

.group > .rule
{
	color: #f0e6ff;
}

.group > .rule > span
{
	background-color: #8a6cc4;
}

progress fill
{
	background-color: #8a6cc4;
	decorator: horizontal-gradient(#5a3c8c #b48cff);
}

/* Check boxes, sliders and scroll bars, square and lit in Yuri's colours. */
input[type='checkbox']
{
	border: 2dp #6a4ca8;
	background-color: #000000;
	decorator: none;
}

input[type='checkbox']:checked
{
	border-color: #b48cff;
	decorator: vertical-gradient(#e0c8ff #8a5ce0);
}

input[type='checkbox']:disabled
{
	border-color: #3a2c58;
	background-color: #120c1c;
	decorator: none;
}

input[type='checkbox']:checked:disabled
{
	border-color: #3a2c58;
	decorator: vertical-gradient(#7a6a96 #4a3870);
}

input[type='range'] slidertrack
{
	background-color: transparent;
	decorator: none;
}

input[type='range'] sliderbar
{
	border: 1dp #e8dcff;
	background-color: #8a5ce0;
	decorator: vertical-gradient(#c8a8ff #5a3c8c);
}

input[type='range']:disabled sliderbar
{
	border-color: #3a2c58;
	background-color: #2a2040;
	decorator: none;
}

scrollbarvertical
{
	border-left-color: #6a4ca8;
}

scrollbarvertical slidertrack
{
	background-color: #000000c0;
	decorator: none;
}

scrollbarvertical sliderbar
{
	border: 1dp #b48cff;
	background-color: #5a3c8c;
	decorator: horizontal-gradient(#7a54b8 #4a2c78);
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc
{
	background-color: #2a1c44;
	border-color: #b48cff80 #00000080 #00000080 #b48cff80;
}

scrollbarvertical sliderarrowdec:active, scrollbarvertical sliderarrowinc:active
{
	background-color: #3a2860;
	border-color: #00000080 #b48cff80 #b48cff80 #00000080;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowdec:active
{
	decorator: image(arrow-up.png fill);
}

scrollbarvertical sliderarrowinc, scrollbarvertical sliderarrowinc:active
{
	decorator: image(arrow-down.png fill);
}

select selectarrow, select:disabled selectarrow, select.disabled selectarrow
{
	background-color: #2a1c44;
	decorator: image(arrow-down.png fill);
}

/* The version and copyright in the bottom bar of the main menu screen, left of the column. */
#stamp
{
	position: absolute;
	left: 50%;
	top: 50%;
	width: 316dp;
	margin-left: -88dp;
	margin-top: 271dp;
	text-align: right;
	font-family: fullfnt;
	font-size: 11dp;
	line-height: 13dp;
	color: #c8b8e8;
	pointer-events: none;
}

/* The Controls page in the classic frame. Its panel covers the stage art left of the right-hand column, the
   command list scrolls inside the panel, and the editor stands at the panel's right. Back and OK take the
   column's buttons, and Reset to defaults sits at the panel's foot. Sizes are in dp. */
body[data-model="keyboard"] #reveal
{
	position: absolute;
	left: 50%;
	top: 50%;
	width: 800dp;
	height: 600dp;
	margin-left: -400dp;
	margin-top: -300dp;
}

body[data-model="keyboard"] #wallpaper
{
	right: 168dp;
	bottom: 32dp;
}

/* Keeps #chrome in normal flow. An absolute #chrome stayed about 400dp right of the stage after the screen reveal. */
body[data-model="keyboard"] #chrome
{
	position: static;
	left: auto;
	right: auto;
	width: auto;
	height: 600dp;
	margin: 0;
}

body[data-model="keyboard"] #page
{
	position: absolute;
	left: 0;
	top: 0;
	width: 632dp;
	height: 568dp;
	flex: none;
	display: block;
}

body[data-model="keyboard"] #list
{
	position: absolute;
	left: 0;
	top: 0;
	width: 632dp;
	height: 568dp;
	flex: none;
	display: block;
	padding: 0;
	overflow: visible;
}

body[data-model="keyboard"] #filters
{
	position: absolute;
	left: 14dp;
	top: 12dp;
	width: 604dp;
	height: 46dp;
}

body[data-model="keyboard"] #scheme-field
{
	width: 190dp;
}

body[data-model="keyboard"] #search-field
{
	flex: 1 1 auto;
	min-width: 0;
}

body[data-model="keyboard"] #category-field
{
	width: 200dp;
}

body[data-model="keyboard"] .head-row
{
	position: absolute;
	left: 14dp;
	top: 70dp;
	width: 372dp;
	margin: 0;
	padding: 0 8dp;
}

body[data-model="keyboard"] .head-row .slot-head, body[data-model="keyboard"] .slot
{
	flex: 0 0 100dp;
	width: 100dp;
}

body[data-model="keyboard"] #commands
{
	position: absolute;
	left: 14dp;
	top: 98dp;
	width: 372dp;
	height: 330dp;
	margin: 0;
}

body[data-model="keyboard"] #list-footer
{
	position: absolute;
	left: 14dp;
	top: 436dp;
	margin: 0;
}

body[data-model="keyboard"] #side
{
	position: absolute;
	left: 404dp;
	top: 70dp;
	width: 214dp;
	height: 440dp;
	flex: none;
	padding: 0;
	overflow: visible;
}

body[data-model="keyboard"] #capture-row
{
	display: block;
	height: auto;
}

body[data-model="keyboard"] #capture
{
	width: 214dp;
}

body[data-model="keyboard"] #trigger
{
	width: 214dp;
	margin-left: 0;
	margin-top: 8dp;
}

body[data-model="keyboard"] #assign, body[data-model="keyboard"] #clear, body[data-model="keyboard"] #swap, body[data-model="keyboard"] #dismiss
{
	width: 100dp;
}

body[data-model="keyboard"] #assign
{
	margin-right: 8dp;
}

body[data-model="keyboard"] #footer
{
	position: absolute;
	left: 0;
	top: 0;
	width: 0;
	height: 0;
	padding: 0;
	display: block;
}

body[data-model="keyboard"] #footer-spacer
{
	display: none;
}

body[data-model="keyboard"] #footer button
{
	position: absolute;
	margin: 0;
	width: 162dp;
	height: 37dp;
	padding-top: 11dp;
}

body[data-model="keyboard"] #footer #footer-reset
{
	left: 14dp;
	top: 520dp;
	width: 180dp;
	height: 34dp;
	padding-top: 8dp;
}

body[data-model="keyboard"] #footer #footer-cancel
{
	left: 635dp;
	top: 519dp;
}

body[data-model="keyboard"] #footer #footer-ok
{
	left: 635dp;
	top: 563dp;
}

/* The Options page's check boxes keep each label on one line in the right-hand box, which is
   widened to the column and set a size smaller, so the longest label fits. */
body[data-model="classicopt"] #more
{
	left: 634dp;
	width: 164dp;
}

body[data-model="classicopt"] #more label.check
{
	left: 4dp;
	width: 156dp;
	font-size: 11dp;
	white-space: nowrap;
}
