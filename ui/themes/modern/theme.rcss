/* The modern menu style: Yuri's Revenge's title art behind dark, crisp panels. It restyles the
   shared kit and keeps every screen's layout. Sizes are in dp, laid out for 1280x720. */

body
{
	font-family: fullfnt;
	color: #ece6f7;
}

/* Yuri's Revenge's title art fills the window behind the menus, dimmed. */
#screen-bg
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: -2;
	background-color: #05040a;
	pointer-events: none;
}

#screen-art
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image(GLSLMD.SHP@GLSMD.PAL cover center top);
}

#screen-shade
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(#0a061299 #05030ae6);
}

/* Over a game in progress the art gives way to a light shade, so the panel stands out from the
   battlefield. */
.ingame #screen-bg
{
	background-color: transparent;
}

.ingame #screen-art
{
	display: none;
}

.ingame #screen-shade
{
	background-color: #0000006c;
	decorator: none;
}

/* The panel replaces Tiberian Sun's chrome: no side bars, glow or teal backdrop. */
#bar-left, #bar-right, #edge-left, #edge-right, #glow, #wallpaper-art,
.revealing #edge-left, .revealing #edge-right
{
	display: none;
}

#wallpaper
{
	background-color: #120d1ce8;
	border: 1dp #6b43a8;
	border-radius: 6dp;
}

/* Text */
.caption, .value
{
	color: #d9c8ff;
}

/* Buttons */
button, button.wide, button.tall
{
	height: 26dp;
	border: 1dp #4d3d6b;
	border-radius: 3dp;
	padding: 4dp 8dp 0 8dp;
	color: #ece6f7;
	background-color: transparent;
	decorator: vertical-gradient(#2e2640 #18131f);
}

button.tall
{
	height: 32dp;
	padding-top: 7dp;
}

button:hover, button.wide:hover, button.tall:hover
{
	border-color: #b46bff;
	color: #ffffff;
	decorator: vertical-gradient(#3d2f57 #1f1829);
}

button:active, button.wide:active, button.tall:active
{
	position: relative;
	top: 0;
	border: 1dp #d29bff;
	padding: 5dp 8dp 0 8dp;
	decorator: vertical-gradient(#1a1424 #2a203a);
}

button.disabled, button:disabled, button.wide.disabled, button.wide:disabled, button.tall.disabled, button.tall:disabled,
button.disabled:active, button:disabled:active, button.wide.disabled:active, button.wide:disabled:active,
button.tall.disabled:active, button.tall:disabled:active
{
	position: relative;
	top: 0;
	border: 1dp #2c2638;
	padding: 4dp 8dp 0 8dp;
	color: #5f5873;
	decorator: vertical-gradient(#1c1825 #141119);
}

.keys button:focus, .keys label.check:focus
{
	color: #ffffff;
	border-color: #d29bff;
}

.keys button.disabled:focus
{
	color: #5f5873;
}

/* Fields, lists and drop-down boxes */
input[type='range'], input[type='text'], input[type='password'], textarea, select, .hotkey, .list
{
	border-color: #4d3d6b;
	background-color: #0b0812d0;
}

.keys .list:focus, .keys select:focus, .keys input[type='range']:focus
{
	border-color: #d29bff;
}

.list .item, select option
{
	color: #ece6f7;
}

.list .item:checked, .list .item.selected, select option:checked
{
	background-color: #4a2f78;
	color: #ffffff;
}

select selectbox
{
	background-color: #120d1c;
	border: 1dp #6b43a8;
}

/* Check boxes */
input[type='checkbox']
{
	border: 1dp #6b43a8;
	border-radius: 3dp;
	background-color: #0b0812;
	decorator: none;
}

input[type='checkbox']:checked
{
	background-color: #b46bff;
	decorator: none;
}

input[type='checkbox']:disabled
{
	border-color: #2c2638;
	background-color: #1c1825;
	decorator: none;
}

input[type='checkbox']:checked:disabled
{
	border-color: #2c2638;
	background-color: #5f4a80;
	decorator: none;
}

/* Sliders */
input[type='range'] slidertrack
{
	background-color: #1c1528;
	decorator: none;
}

input[type='range'] sliderbar
{
	border-radius: 2dp;
	background-color: #b46bff;
	decorator: none;
}

/* Scroll bars */
scrollbarvertical
{
	border-left-color: #2e2640;
}

scrollbarvertical slidertrack
{
	background-color: #0b0812;
	decorator: none;
}

scrollbarvertical sliderbar
{
	border-radius: 2dp;
	background-color: #4d3d6b;
	decorator: none;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc,
scrollbarvertical sliderarrowdec:active, scrollbarvertical sliderarrowinc:active
{
	background-color: #2e2640;
	decorator: none;
}

.tooltip
{
	background-color: #120d1cf0;
	border: 1dp #6b43a8;
	color: #ece6f7;
}

/* Text everywhere in the vector face, a notch smaller than the bitmap font it replaces. */
body
{
	font-size: 14dp;
}

.sans, input[type='text'], input[type='password'], textarea, .list, .tooltip, .hotkey, .group > label, .group > .rule
{
	font-family: fullfnt;
	font-size: 14dp;
}

input[type='text'], input[type='password'], textarea, .hotkey, select, select option
{
	color: #ece6f7;
	caret-color: #d29bff;
}

input selection, textarea selection
{
	background-color: #4a2f78;
	color: #ffffff;
}

select:disabled, select.disabled, .trough.disabled
{
	color: #5f5873;
}

/* Value boxes, frames and group outlines */
.trough, .trough.disabled
{
	border: 1dp #4d3d6b;
	background-color: #0b0812d0;
	color: #ece6f7;
	decorator: none;
}

.trough-edge, .trough-edge.disabled
{
	background-color: transparent;
}

.frame, .group, progress, select selectbox
{
	border-color: #4d3d6b;
}

.group > .rule
{
	color: #d9c8ff;
}

.group > .rule > span
{
	background-color: #4d3d6b;
}

progress fill
{
	background-color: #b46bff;
	decorator: horizontal-gradient(#6b43a8 #b46bff);
}

/* Arrows */
select selectarrow, select:disabled selectarrow, select.disabled selectarrow
{
	background-color: #2e2640;
	decorator: image(arrow-down.png fill);
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowdec:active
{
	decorator: image(arrow-up.png fill);
}

scrollbarvertical sliderarrowinc, scrollbarvertical sliderarrowinc:active
{
	decorator: image(arrow-down.png fill);
}

/* The version and copyright in the bottom right corner of the main menu. */
#stamp
{
	position: absolute;
	right: 16dp;
	bottom: 10dp;
	width: 480dp;
	text-align: right;
	font-family: fullfnt;
	font-size: 12dp;
	line-height: 16dp;
	color: #8f84a8;
	pointer-events: none;
}

/* The title screen menus stand in one panel on the left, the same size for every menu, with
   the menu's name at the top and its buttons stacked below. */
body.titlemenu #backdrop #reveal
{
	width: 248dp;
	height: 330dp;
	top: 50%;
	margin: -165dp 0 0 8%;
}

body.titlemenu #content
{
	padding: 62dp 0 0 0;
}

body.titlemenu #content > button
{
	position: static;
	display: block;
	width: 192dp;
	height: 34dp;
	margin: 0 auto 10dp auto;
}

body.titlemenu #title
{
	display: block;
	position: absolute;
	left: 0;
	top: 20dp;
	width: 100%;
	height: 24dp;
	font-size: 18dp;
	line-height: 24dp;
	text-align: center;
	color: #d9c8ff;
}

/* The skirmish lobby fills most of the screen: the player list on the left, the map and the game
   settings on the right. Its rows keep their order and the columns share the width. */
body.lobby #backdrop #reveal
{
	width: 1040dp;
	height: 572dp;
	top: 50%;
	margin-top: -286dp;
}

body.lobby #content
{
	padding: 24dp 28dp 0 28dp;
}

body.lobby #left
{
	width: 668dp;
	margin-right: 28dp;
}

body.lobby #right
{
	width: 288dp;
}

body.lobby #players
{
	padding: 10dp 12dp 8dp 12dp;
	background-color: #0b0812a0;
	border-radius: 4dp;
}

body.lobby #headings
{
	height: 24dp;
}

body.lobby #headings > .caption
{
	height: 24dp;
	line-height: 24dp;
	font-size: 12dp;
	color: #a99bc9;
}

body.lobby .slot
{
	height: 42dp;
	border-top: 1dp #2e2640;
}

body.lobby .col-player { width: 196dp; margin-right: 8dp; }
body.lobby .col-side { width: 132dp; margin-right: 8dp; }
body.lobby .col-color { width: 128dp; margin-right: 8dp; }
body.lobby .col-start { width: 84dp; margin-right: 8dp; }
body.lobby .col-team { width: 72dp; }

body.lobby .cell
{
	height: 32dp;
}

body.lobby .chip
{
	width: 14dp;
	height: 20dp;
	margin-right: 6dp;
	border-radius: 2dp;
}

body.lobby #switches
{
	margin-top: 12dp;
	padding: 12dp 14dp 6dp 14dp;
}

body.lobby #map
{
	width: 288dp;
	height: 162dp;
}

body.lobby #preview
{
	width: 286dp;
	height: 160dp;
}

body.lobby #preview-caption
{
	width: 286dp;
	top: 68dp;
}

body.lobby #mapname
{
	width: 288dp;
	height: 22dp;
	margin-top: 8dp;
	line-height: 22dp;
}

body.lobby #pick
{
	width: 288dp;
	margin-top: 6dp;
}

body.lobby #settings
{
	width: 288dp;
	margin-top: 12dp;
	padding: 10dp 0 4dp 12dp;
}

body.lobby .setting
{
	height: 52dp;
}

body.lobby .setting input[type='range']
{
	width: 180dp;
}

body.lobby #notice
{
	height: 20dp;
	margin-top: 8dp;
	line-height: 20dp;
}

body.lobby #ok, body.lobby #cancel
{
	width: 136dp;
}

/* The Settings screen: one panel with a tab for the game, display, audio, keyboard and mods
   pages. Each page is its own screen; the tab bar and the panel stand in the same place for
   all of them, and the page's content is centered in the panel. */
#tabs
{
	display: none;
}

.settings #tabs
{
	display: flex;
	position: absolute;
	left: 50%;
	top: 50%;
	width: 560dp;
	height: 34dp;
	margin-left: -280dp;
	margin-top: -229dp;
	z-index: 2;
}

/* Every page has the panel of the tallest one (the mods list, 424dp), and the tab bar and panel
   together stand in the middle of the screen, so the block stays put from tab to tab. */
.settings #backdrop #reveal
{
	width: 560dp;
	height: 424dp;
	top: 50%;
	margin-top: -195dp;
}

/* The page's own content stands in the middle of the panel. */
.settings #content
{
	display: flex;
	flex-direction: column;
	justify-content: center;
	height: 100%;
	padding-top: 0;
	padding-bottom: 0;
}

#tabs button.tab
{
	flex: 1 1 0;
	height: 34dp;
	margin: 0 3dp 0 0;
	padding: 8dp 4dp 0 4dp;
	border: 1dp #4d3d6b;
	border-bottom-width: 0;
	border-radius: 5dp 5dp 0 0;
	text-align: center;
	color: #b9aad6;
	background-color: transparent;
	decorator: vertical-gradient(#2a2238 #18131f);
}

#tabs button.tab:last-child
{
	margin-right: 0;
}

#tabs button.tab.gone
{
	display: none;
}

#tabs button.tab:hover
{
	border-color: #b46bff;
	color: #ffffff;
	decorator: vertical-gradient(#3d2f57 #1f1829);
}

#tabs button.tab:active
{
	padding: 8dp 4dp 0 4dp;
	decorator: vertical-gradient(#1a1424 #2a203a);
}

/* The tab of the page on show joins the panel below it. */
#tabs button.tab.active, #tabs button.tab.active:hover, #tabs button.tab.active:active
{
	height: 35dp;
	border-color: #6b43a8;
	color: #ffffff;
	background-color: #120d1c;
	decorator: none;
}

.keys #tabs button.tab:focus
{
	color: #ffffff;
	border-color: #d29bff;
}

.settings.tab-game #content
{
	padding-left: 91dp;
	padding-right: 91dp;
}

.settings.tab-display #content
{
	padding-left: 141dp;
	padding-right: 141dp;
}

.settings.tab-audio #content
{
	padding-left: 92dp;
	padding-right: 92dp;
}

.settings.tab-keyboard #content
{
	padding-left: 60dp;
	padding-right: 60dp;
}

/* The tabs take the place of the buttons that led from the game controls to the other pages. */
.settings #buttons > #sound, .settings #buttons > #keyboard
{
	display: none;
}
