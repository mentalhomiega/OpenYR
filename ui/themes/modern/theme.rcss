 ******************************************************************************/

/* The modern menu style: Yuri's Revenge's title art behind dark, crisp panels. It restyles the
   shared kit and keeps every screen's layout. Sizes are in dp, laid out for 1280x720. */

body
{
	font-family: fullfnt;
	color: var(--t-text, #ece6f7);
}

/* Yuri's Revenge's title art fills the window behind the menus, dimmed. */
#screen-bg
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: -2;
	background-color: var(--t-ink, #05040a);
	pointer-events: none;
}

#screen-art
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image(GLSLMD.SHP@GLSMD.PAL cover center top);
}

#screen-shade
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(var(--t-shade-top, #0a061299) var(--t-shade-bottom, #05030ae6));
}

/* Over a game in progress the art gives way to a light shade, so the panel stands out from the
   battlefield. */
.ingame #screen-bg
{
	background-color: transparent;
}

.ingame #screen-art
{
	display: none;
}

.ingame #screen-shade
{
	background-color: #0000006c;
	decorator: none;
}

/* The menu battle shows through in place of the title art, under a shade dark enough for text. */
.live #screen-bg
{
	background-color: transparent;
}

.live #screen-art
{
	display: none;
}

.live #screen-shade
{
	background-color: #00000058;
	decorator: none;
}

/* On the title menus the shade darkens from the left, where the menu panel stands, and the battle
   stays clear on the right. */
#screen-vignette
{
	display: none;
	position: absolute;
	left: 0;
	top: 0;
	width: 60%;
	height: 100%;
	decorator: horizontal-gradient(#000000c0 #00000000);
}

body.titlemenu.live #screen-shade
{
	background-color: #00000018;
}

body.titlemenu.live #screen-vignette
{
	display: block;
}

/* The panel replaces Tiberian Sun's chrome: no side bars, glow or teal backdrop. */
#bar-left, #bar-right, #edge-left, #edge-right, #glow, #wallpaper-art,
.revealing #edge-left, .revealing #edge-right
{
	display: none;
}

#wallpaper
{
	background-color: var(--t-panel, #120d1ce8);
	border: 1dp var(--t-edge, #6b43a8);
	border-radius: 6dp;
}

/* Text */
.caption, .value
{
	color: var(--t-caption, #d9c8ff);
}

/* Buttons */
button, button.wide, button.tall
{
	height: 26dp;
	border: 1dp var(--t-edge-dim, #4d3d6b);
	border-radius: 3dp;
	padding: 4dp 8dp 0 8dp;
	color: var(--t-text, #ece6f7);
	background-color: transparent;
	decorator: vertical-gradient(var(--t-face-top, #2e2640) var(--t-face-bottom, #18131f));
}

button.tall
{
	height: 32dp;
	padding-top: 7dp;
}

button:hover, button.wide:hover, button.tall:hover
{
	border-color: var(--t-accent, #b46bff);
	color: var(--t-text-hot, #ffffff);
	decorator: vertical-gradient(var(--t-hover-top, #3d2f57) var(--t-hover-bottom, #1f1829));
}

button:active, button.wide:active, button.tall:active
{
	position: relative;
	top: 0;
	border: 1dp var(--t-accent-strong, #d29bff);
	padding: 5dp 8dp 0 8dp;
	decorator: vertical-gradient(var(--t-press-top, #1a1424) var(--t-press-bottom, #2a203a));
}

button.disabled, button:disabled, button.wide.disabled, button.wide:disabled, button.tall.disabled, button.tall:disabled,
button.disabled:active, button:disabled:active, button.wide.disabled:active, button.wide:disabled:active,
button.tall.disabled:active, button.tall:disabled:active
{
	position: relative;
	top: 0;
	border: 1dp var(--t-disabled-edge, #2c2638);
	padding: 4dp 8dp 0 8dp;
	color: var(--t-disabled-text, #5f5873);
	decorator: vertical-gradient(var(--t-disabled-top, #1c1825) var(--t-disabled-bottom, #141119));
}

.keys button:focus, .keys label.check:focus
{
	color: var(--t-text-hot, #ffffff);
	border-color: var(--t-accent-strong, #d29bff);
}

.keys button.disabled:focus
{
	color: var(--t-disabled-text, #5f5873);
}

/* Fields, lists and drop-down boxes */
input[type='range'], input[type='text'], input[type='password'], textarea, select, .hotkey, .list
{
	border-color: var(--t-edge-dim, #4d3d6b);
	background-color: var(--t-field, #0b0812d0);
}

.keys .list:focus, .keys select:focus, .keys input[type='range']:focus
{
	border-color: var(--t-accent-strong, #d29bff);
}

.list > .rows
{
	background-color: transparent;
}

.list .item, select option
{
	color: var(--t-text, #ece6f7);
}

/* A row of a list keeps a 3dp edge at its left; the picked row's edge shows the accent, so the pick
   reads without its colour. */
.list .item
{
	height: 26dp;
	padding-left: 8dp;
	border-left: 3dp transparent;
	line-height: 24dp;
}

.list .item:hover
{
	background-color: #ffffff12;
}

.list .item:checked, .list .item.selected, select option:checked
{
	background-color: var(--t-select, #4a2f78);
	color: var(--t-text-hot, #ffffff);
}

.list .item:checked, .list .item.selected
{
	border-left-color: var(--t-accent, #b46bff);
}

select selectbox
{
	background-color: var(--t-popup, #120d1c);
	border: 1dp var(--t-edge, #6b43a8);
}

/* Check boxes */
input[type='checkbox']
{
	border: 1dp var(--t-edge, #6b43a8);
	border-radius: 3dp;
	background-color: var(--t-field-solid, #0b0812);
	decorator: none;
}

input[type='checkbox']:checked
{
	border-color: var(--t-accent-strong, #d29bff);
	background-color: var(--t-accent, #b46bff);
	decorator: image(check.png fill);
}

input[type='checkbox']:disabled
{
	border-color: var(--t-disabled-edge, #2c2638);
	background-color: var(--t-disabled-top, #1c1825);
	decorator: none;
}

input[type='checkbox']:checked:disabled
{
	border-color: var(--t-disabled-edge, #2c2638);
	background-color: var(--t-disabled-check, #5f4a80);
	decorator: image(check.png fill);
}

/* Sliders */
input[type='range'] slidertrack
{
	background-color: var(--t-track, #1c1528);
	decorator: none;
}

input[type='range'] sliderbar
{
	border-radius: 2dp;
	background-color: var(--t-accent, #b46bff);
	decorator: none;
}

/* Scroll bars */
scrollbarvertical
{
	border-left-color: var(--t-face-top, #2e2640);
}

scrollbarvertical slidertrack
{
	background-color: var(--t-field-solid, #0b0812);
	decorator: none;
}

scrollbarvertical sliderbar
{
	border-radius: 2dp;
	background-color: var(--t-edge-dim, #4d3d6b);
	decorator: none;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc,
scrollbarvertical sliderarrowdec:active, scrollbarvertical sliderarrowinc:active
{
	background-color: var(--t-face-top, #2e2640);
	decorator: none;
}

.tooltip
{
	background-color: var(--t-tooltip, #120d1cf0);
	border: 1dp var(--t-edge, #6b43a8);
	color: var(--t-text, #ece6f7);
}

/* Text everywhere in the vector face, a notch smaller than the bitmap font it replaces. */
body
{
	font-size: 14dp;
}

.sans, input[type='text'], input[type='password'], textarea, .list, .tooltip, .hotkey, .group > label, .group > .rule
{
	font-family: fullfnt;
	font-size: 14dp;
}

input[type='text'], input[type='password'], textarea, .hotkey, select, select option
{
	color: var(--t-text, #ece6f7);
	caret-color: var(--t-accent-strong, #d29bff);
}

input selection, textarea selection
{
	background-color: var(--t-select, #4a2f78);
	color: var(--t-text-hot, #ffffff);
}

select:disabled, select.disabled, .trough.disabled
{
	color: var(--t-disabled-text, #5f5873);
}

/* Value boxes, frames and group outlines */
.trough, .trough.disabled
{
	border: 1dp var(--t-edge-dim, #4d3d6b);
	background-color: var(--t-field, #0b0812d0);
	color: var(--t-text, #ece6f7);
	decorator: none;
}

.trough-edge, .trough-edge.disabled
{
	background-color: transparent;
}

.frame, .group, progress, select selectbox
{
	border-color: var(--t-edge-dim, #4d3d6b);
}

.group > .rule
{
	color: var(--t-caption, #d9c8ff);
}

.group > .rule > span
{
	background-color: var(--t-edge-dim, #4d3d6b);
}

progress fill
{
	background-color: var(--t-accent, #b46bff);
	decorator: horizontal-gradient(var(--t-edge, #6b43a8) var(--t-accent, #b46bff));
}

/* Arrows */
select selectarrow, select:disabled selectarrow, select.disabled selectarrow
{
	background-color: var(--t-face-top, #2e2640);
	decorator: image(arrow-down.png fill);
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowdec:active
{
	decorator: image(arrow-up.png fill);
}

scrollbarvertical sliderarrowinc, scrollbarvertical sliderarrowinc:active
{
	decorator: image(arrow-down.png fill);
}

/* The version and copyright in the bottom right corner of the main menu. */
#stamp
{
	position: absolute;
	right: 16dp;
	bottom: 10dp;
	width: 480dp;
	text-align: right;
	font-family: fullfnt;
	font-size: 12dp;
	line-height: 16dp;
	color: #e8e8e8d8;
	font-effect: shadow(1dp 1dp #000000);
	pointer-events: none;
}

/* The screen-edge frame: a tinted border round the window, over every screen. */
#frame
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	border: 4dp var(--t-frame, #6b43a8);
	pointer-events: none;
}

/* The profile panel at the top left of the title menus: the player's name over a smaller line. */
#profile
{
	display: none;
	position: absolute;
	right: 16dp;
	top: 16dp;
	width: 200dp;
	height: 50dp;
	padding: 6dp 10dp 0 10dp;
	background-color: var(--t-panel, #120d1ce8);
	border: 1dp var(--t-edge, #6b43a8);
	border-radius: 3dp;
	pointer-events: none;
}

#profile-name
{
	font-size: 16dp;
	line-height: 20dp;
	color: var(--t-text-hot, #ffffff);
}

#profile-line
{
	font-size: 11dp;
	line-height: 14dp;
	color: var(--t-muted, #a99bc9);
}

/* The version at the bottom left of the title menus. */
#emblem
{
	display: none;
	position: absolute;
	left: 16dp;
	bottom: 10dp;
	width: 240dp;
	height: 16dp;
	pointer-events: none;
}

#badge-version
{
	position: absolute;
	left: 0;
	top: 0;
	width: 240dp;
	height: 16dp;
	font-size: 12dp;
	line-height: 16dp;
	text-align: left;
	color: #e8e8e8d8;
	font-effect: shadow(1dp 1dp #000000);
}

body.titlemenu #profile, body.titlemenu #emblem
{
	display: block;
}

/* The title screen menus stand in one panel on the left, with the menu's name at the top and its
   buttons stacked below. The panel is as tall as its buttons need; the count-N class gives the number. */
body.titlemenu #backdrop #reveal
{
	width: 300dp;
	height: 366dp;
	top: 50%;
	margin: -183dp 0 0 7%;
}

body.titlemenu.count-4 #backdrop #reveal
{
	height: 270dp;
	margin-top: -135dp;
}

body.titlemenu.count-5 #backdrop #reveal
{
	height: 318dp;
	margin-top: -159dp;
}

/* The main menu has no caption: its buttons start at the top of the panel. */
body.titlemenu.main #backdrop #reveal
{
	height: 328dp;
	margin-top: -164dp;
}

body.titlemenu #wallpaper, body.lobby #wallpaper, body.missionbrowser #wallpaper, body.dlg #wallpaper
{
	border-width: 1dp 1dp 1dp 3dp;
	border-color: var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-accent, #b46bff);
	border-radius: 2dp;
}

body.titlemenu #content
{
	padding: 66dp 0 0 0;
}

body.titlemenu.main #content
{
	padding-top: 24dp;
}

body.titlemenu #content > button
{
	position: static;
	display: block;
	width: 244dp;
	height: 40dp;
	margin: 0 auto 8dp auto;
	padding: 11dp 16dp 0 16dp;
	font-size: 16dp;
	text-align: left;
	border-radius: 2dp;
}

body.titlemenu #content > button:hover
{
	border-left-width: 4dp;
	padding-left: 19dp;
}

body.titlemenu #content > button:active
{
	padding: 12dp 16dp 0 16dp;
}

body.titlemenu #content > button.disabled, body.titlemenu #content > button:disabled
{
	padding: 11dp 16dp 0 16dp;
}

body.titlemenu #title
{
	display: block;
	position: absolute;
	left: 28dp;
	top: 22dp;
	width: 244dp;
	height: 28dp;
	font-size: 16dp;
	line-height: 26dp;
	text-align: left;
	color: var(--t-muted, #a99bc9);
	border-bottom: 1dp var(--t-edge-dim, #4d3d6b);
}

body.titlemenu.main #title
{
	display: none;
}

/* The skirmish lobby fills most of the screen: the player list on the left, the map and the game
   settings on the right. Its rows keep their order and the columns share the width. */
body.lobby #backdrop #reveal
{
	width: 1040dp;
	height: 640dp;
	top: 50%;
	margin-top: -320dp;
}

body.lobby #content
{
	padding: 22dp 28dp 0 28dp;
}

body.lobby #title, body.dlg #title, body.missionbrowser #list-caption, body.page-mods #title
{
	display: block;
	height: 28dp;
	margin: 0 0 14dp 0;
	padding: 0;
	font-size: 16dp;
	line-height: 26dp;
	text-align: left;
	text-transform: none;
	color: var(--t-muted, #a99bc9);
	border-bottom: 1dp var(--t-edge-dim, #4d3d6b);
}

body.lobby #left
{
	width: 668dp;
	margin-right: 28dp;
}

body.lobby #right
{
	width: 288dp;
}

body.lobby #players
{
	padding: 10dp 12dp 8dp 12dp;
	background-color: var(--t-field-list, #0b0812a0);
	border-radius: 4dp;
}

body.lobby #headings
{
	height: 24dp;
}

body.lobby #headings > .caption
{
	height: 24dp;
	line-height: 24dp;
	font-size: 12dp;
	color: var(--t-muted, #a99bc9);
}

body.lobby .slot
{
	height: 42dp;
	border-top: 1dp var(--t-rule, #2e2640);
}

body.lobby .col-player { width: 196dp; margin-right: 8dp; }
body.lobby .col-side { width: 132dp; margin-right: 8dp; }
body.lobby .col-color { width: 128dp; margin-right: 8dp; }
body.lobby .col-start { width: 84dp; margin-right: 8dp; }
body.lobby .col-team { width: 72dp; }

body.lobby .cell
{
	height: 32dp;
}

body.lobby .chip
{
	width: 14dp;
	height: 20dp;
	margin-right: 6dp;
	border-radius: 2dp;
}

body.lobby .colour-name
{
	font-size: 13dp;
}

body.lobby #switches
{
	margin-top: 12dp;
	padding: 12dp 14dp 8dp 14dp;
	background-color: var(--t-field-list, #0b0812a0);
	border-radius: 4dp;
}

body.lobby #switches > label.check
{
	height: 30dp;
	margin-bottom: 0;
	line-height: 26dp;
}

body.lobby #switches > label.check > input
{
	margin-right: 8dp;
	vertical-align: middle;
}

body.lobby #map
{
	width: 288dp;
	height: 162dp;
}

body.lobby #preview
{
	width: 286dp;
	height: 160dp;
}

body.lobby #preview-caption
{
	width: 286dp;
	top: 68dp;
}

body.lobby #mapname
{
	width: 288dp;
	height: 22dp;
	margin-top: 8dp;
	line-height: 22dp;
}

body.lobby #pick
{
	width: 288dp;
	margin-top: 6dp;
}

body.lobby #settings
{
	width: 288dp;
	margin-top: 12dp;
	padding: 10dp 0 4dp 12dp;
	background-color: var(--t-field-list, #0b0812a0);
	border-radius: 4dp;
}

body.lobby .setting
{
	height: 52dp;
}

body.lobby .setting input[type='range']
{
	width: 180dp;
}

body.lobby #notice
{
	height: 20dp;
	margin-top: 8dp;
	line-height: 20dp;
	color: var(--t-accent-strong, #d29bff);
}

body.lobby #buttons
{
	margin-top: 6dp;
}

body.lobby #ok, body.lobby #cancel
{
	width: 136dp;
}

body.lobby #ok
{
	margin-right: 16dp;
}

body.lobby #pick
{
	height: 36dp;
	padding-top: 9dp;
}

/* The Settings screen: a column of tabs down the left, with the page to its right. The whole screen is one
   translucent tinted backdrop, the .settings-backdrop class, so the game behind it shows through. The
   backdrop's colour and opacity are set in that one class; the tab column and the page sit on top of it. */
#tabs
{
	display: none;
}

.settings #tabs
{
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 200dp;
	padding: 16dp 12dp 0 12dp;
	background-color: var(--t-column, #0a0814e6);
	border-right: 1dp var(--t-column-edge, #3b2f55);
	z-index: 2;
}

#tabs button.tab
{
	display: block;
	width: 100%;
	height: 40dp;
	margin: 0 0 6dp 0;
	padding: 10dp 12dp 0 16dp;
	border: 1dp var(--t-edge-dim, #4d3d6b);
	border-radius: 4dp;
	text-align: left;
	color: var(--t-tab-text, #b9aad6);
	background-color: transparent;
	decorator: vertical-gradient(var(--t-tab-top, #2a2238) var(--t-face-bottom, #18131f));
}

#tabs button.tab.gone
{
	display: none;
}

#tabs button.tab:hover
{
	border-color: var(--t-accent, #b46bff);
	color: var(--t-text-hot, #ffffff);
	decorator: vertical-gradient(var(--t-hover-top, #3d2f57) var(--t-hover-bottom, #1f1829));
}

#tabs button.tab:active
{
	padding: 10dp 12dp 0 16dp;
	decorator: vertical-gradient(var(--t-press-top, #1a1424) var(--t-press-bottom, #2a203a));
}

/* The tab of the page on show has an accent bar at its left and joins the page. */
#tabs button.tab.active, #tabs button.tab.active:hover, #tabs button.tab.active:active
{
	border-color: var(--t-accent-strong, #d29bff);
	border-left-width: 5dp;
	color: var(--t-text-hot, #ffffff);
	background-color: var(--t-tab-active, #120d1c);
	decorator: none;
}

.keys #tabs button.tab:focus
{
	color: var(--t-text-hot, #ffffff);
	border-color: var(--t-accent-strong, #d29bff);
}

/* The backdrop: a translucent tinted fill over the whole screen, at about half opacity. Themes set
   the colour here, with the alpha byte last. The title art behind the menus stays out of the way. */
.settings-backdrop
{
	background-color: var(--t-backdrop, #0a0814cc);
}

.settings-backdrop #screen-bg
{
	display: none;
}

.settings-backdrop #wallpaper
{
	background-color: transparent;
	border: 0dp #00000000;
}

.settings #buttons > #sound, .settings #buttons > #keyboard
{
	display: none;
}

/* Wait notices ("Loading...", "Saving...") are a slim panel with the accent edge of the title menus;
   one without a progress bar is a single line tall. */
body.waitbox #wallpaper
{
	border-width: 1dp 1dp 1dp 3dp;
	border-color: var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-accent, #b46bff);
	border-radius: 2dp;
}

body.waitbox #text
{
	font-size: 16dp;
	line-height: 20dp;
	color: var(--t-text-hot, #ffffff);
}

body.waitbox.nobar #backdrop #reveal
{
	width: 300dp;
	height: 64dp;
	margin-top: -32dp;
}

body.waitbox.nobar #content
{
	padding: 22dp 20dp 0 20dp;
}

body.waitbox.nobar #text
{
	height: 20dp;
}


/* Large and medium buttons. A big button is 40dp tall, as on the title menus, and a medium one 32dp.
   The primary button of a screen has a thick left edge and an accent border, so it reads without its colour. */
button.big, button.mid
{
	text-align: center;
	border-radius: 2dp;
}

button.big
{
	height: 40dp;
	padding: 11dp 12dp 0 12dp;
	font-size: 16dp;
}

button.mid
{
	height: 32dp;
	padding: 7dp 10dp 0 10dp;
}

button.big:active
{
	padding: 12dp 12dp 0 12dp;
}

button.mid:active
{
	padding: 8dp 10dp 0 10dp;
}

button.big.disabled, button.big:disabled, button.big.disabled:active, button.big:disabled:active
{
	padding: 11dp 12dp 0 12dp;
}

button.mid.disabled, button.mid:disabled, button.mid.disabled:active, button.mid:disabled:active
{
	padding: 7dp 10dp 0 10dp;
}

button.primary
{
	border-color: var(--t-accent, #b46bff);
	border-left-width: 4dp;
	color: var(--t-text-hot, #ffffff);
	decorator: vertical-gradient(var(--t-hover-top, #3d2f57) var(--t-hover-bottom, #1f1829));
}

button.primary:hover
{
	border-color: var(--t-accent-strong, #d29bff);
	decorator: vertical-gradient(var(--t-hover-top, #3d2f57) var(--t-face-bottom, #18131f));
}

button.primary:active
{
	border-color: var(--t-accent-strong, #d29bff);
	decorator: vertical-gradient(var(--t-press-top, #1a1424) var(--t-press-bottom, #2a203a));
}

button.primary.disabled, button.primary:disabled, button.primary.disabled:active, button.primary:disabled:active
{
	border-color: var(--t-disabled-edge, #2c2638);
	border-left-width: 1dp;
	color: var(--t-disabled-text, #5f5873);
	decorator: vertical-gradient(var(--t-disabled-top, #1c1825) var(--t-disabled-bottom, #141119));
}

/* The Settings pages. The page sits in from the tab column and the screen edge, its rows are 44dp tall with a
   thin rule between them, and a section heading is a quiet caption over a rule, as on the title menus. A
   row holds its label at the left and its control at the right; a check box comes first, beside its label. */
body.page-settings #list
{
	justify-content: space-between;
	padding: 20dp 20dp 24dp 32dp;
}

body.page-settings #extras, body.page-settings #music
{
	justify-content: space-between;
}

body.page-settings #side
{
	padding: 20dp 28dp 20dp 24dp;
	border-left: 1dp var(--t-rule, #2e2640);
}

body.page-settings #side-title, body.page-settings #editor-name
{
	display: block;
	height: 30dp;
	margin: 0 0 12dp 0;
	font-size: 16dp;
	line-height: 28dp;
	color: var(--t-muted, #a99bc9);
	border-bottom: 1dp var(--t-edge-dim, #4d3d6b);
}

body.page-settings #description
{
	color: var(--t-text, #ece6f7);
}

body.page-settings .side-note
{
	color: var(--t-muted, #a99bc9);
}

body.page-settings .section
{
	height: 30dp;
	margin: 24dp 0 6dp 0;
	padding: 0 13dp;
	font-size: 16dp;
	line-height: 28dp;
	text-align: left;
	color: var(--t-muted, #a99bc9);
	background-color: transparent;
	border-top: 0dp transparent;
	border-bottom: 1dp var(--t-edge-dim, #4d3d6b);
}

body.page-settings #list > .section:first-child
{
	margin-top: 0;
}

body.page-settings #extras > .section:first-child, body.page-settings #music > .section:first-child
{
	margin-top: 24dp;
}

body.page-settings .setting
{
	flex-wrap: nowrap;
	width: 48.5%;
	height: 44dp;
	margin: 0;
	padding: 0 8dp 0 10dp;
	border-left: 3dp transparent;
	border-bottom: 1dp var(--t-rule, #2e2640);
	border-radius: 0;
}

body.page-settings .setting:hover
{
	background-color: #ffffff12;
	border-left-color: var(--t-accent, #b46bff);
}

body.page-settings .setting > .caption
{
	flex: 1 1 auto;
	width: auto;
	min-width: 0;
	margin-right: 12dp;
	line-height: 20dp;
	color: var(--t-text, #ece6f7);
}

body.page-settings .setting.disabled > .caption
{
	color: var(--t-disabled-text, #5f5873);
}

body.page-settings .setting > select
{
	flex: 0 0 auto;
	width: 168dp;
	height: 26dp;
	margin: 0;
}

body.page-settings .setting > input[type='range']
{
	flex: 0 0 auto;
	width: 98dp;
	height: 22dp;
	margin: 0;
}

body.page-settings .setting > .value
{
	flex: 0 0 auto;
	width: 62dp;
	margin: 0 0 0 10dp;
	line-height: 20dp;
	color: var(--t-caption, #d9c8ff);
}

body.page-settings label.check.setting
{
	flex-direction: row-reverse;
	justify-content: flex-end;
	line-height: 20dp;
}

body.page-settings label.check.setting > .caption
{
	margin-right: 0;
}

body.page-settings label.check.setting > input[type='checkbox']
{
	flex: 0 0 auto;
	margin: 0 12dp 0 0;
}

body.page-settings #modes-row
{
	display: none;
}

body.page-settings #modes-select-row
{
	display: flex;
}

body.page-settings #music-buttons button
{
	width: 84dp;
	height: 32dp;
	margin-left: 8dp;
}

body.page-settings #tracks
{
	width: 100%;
	height: 200dp;
	margin-top: 12dp;
}

body.page-settings #footer
{
	flex: 0 0 auto;
	height: 64dp;
	padding: 0 28dp 0 32dp;
	background-color: var(--t-column, #0a0814e6);
	border-top: 1dp var(--t-column-edge, #3b2f55);
}

body.page-settings #footer button
{
	width: 120dp;
	margin-left: 12dp;
}

body.page-settings #footer #footer-reset
{
	width: 180dp;
	margin-left: 0;
}

body.page-settings #footer #footer-ok
{
	width: 140dp;
}

/* The Keyboard page keeps its own columns; its buttons are medium. */
body.page-settings #list-footer button, body.page-settings #editor-buttons button, body.page-settings #conflict-buttons button
{
	height: 32dp;
	padding: 7dp 10dp 0 10dp;
}

body.page-settings #list-footer button:active, body.page-settings #editor-buttons button:active, body.page-settings #conflict-buttons button:active
{
	padding: 8dp 10dp 0 10dp;
}

body.page-settings .head-row
{
	padding: 0 28dp 0 11dp;
}

body.page-settings #capture .prompt
{
	color: var(--t-muted, #a99bc9);
}

/* The Mods page is its own panel to the right of the tab column. */
body.page-mods #reveal
{
	position: absolute;
	left: 200dp;
	right: 0;
	top: 0;
	bottom: 0;
	width: auto;
	height: auto;
	margin: 0;
}

body.page-mods #content
{
	width: 800dp;
	padding: 24dp 32dp 0 32dp;
}

body.page-mods #mods
{
	margin-top: 0;
	height: 270dp;
}

body.page-mods #mods .item
{
	height: 30dp;
	line-height: 28dp;
}

body.page-mods #about
{
	margin-top: 28dp;
	height: 110dp;
	background-color: var(--t-field-list, #0b0812a0);
}

body.page-mods #status
{
	margin-top: 10dp;
	height: 36dp;
	line-height: 18dp;
	color: var(--t-muted, #a99bc9);
}

body.page-mods #status.problem
{
	color: var(--t-accent-strong, #d29bff);
	border-left: 3dp var(--t-accent, #b46bff);
	padding-left: 8dp;
}

body.page-mods #buttons
{
	margin-top: 14dp;
}

body.page-mods #toggle, body.page-mods #up, body.page-mods #down
{
	width: 120dp;
}

body.page-mods #up, body.page-mods #down
{
	margin-left: 8dp;
}

body.page-mods #ok, body.page-mods #cancel
{
	width: 110dp;
}

body.page-mods #ok
{
	margin-left: auto;
}

body.page-mods #cancel
{
	margin-left: 8dp;
}

/* The small dialogs: Movies, Load, Save and Delete, Confirm and the message boxes. Each is a panel with the
   accent edge, a caption over a rule and big buttons at its lower right, the primary one rightmost. */
body.dlg #content
{
	padding: 24dp 32dp 0 32dp;
}

body.dlg #buttons
{
	flex-direction: row-reverse;
	justify-content: flex-start;
}

body.dlg #buttons button
{
	width: 120dp;
	margin: 0 0 0 12dp;
}

body.dlg #buttons button:first-child
{
	margin-left: 0;
}

body.dlg-movies #reveal
{
	width: 480dp;
	height: 424dp;
	margin-top: -212dp;
}

body.dlg-movies #movies
{
	margin-top: 0;
	height: 270dp;
}

body.dlg-movies #buttons
{
	margin-top: 16dp;
}

body.dlg-savegame #reveal
{
	width: 560dp;
	height: 452dp;
	margin-top: -226dp;
}

body.dlg-savegame #headings
{
	margin-top: 0;
	height: 24dp;
	line-height: 24dp;
	font-size: 13dp;
	color: var(--t-muted, #a99bc9);
}

body.dlg-savegame #heading-description
{
	width: 300dp;
	padding-left: 11dp;
}

body.dlg-savegame #heading-stamp, body.dlg-savegame.save #heading-stamp, body.dlg-savegame.delete #heading-stamp
{
	width: 150dp;
	margin-left: 0;
	padding-right: 0;
	text-align: left;
}

body.dlg-savegame #files, body.dlg-savegame.save #files, body.dlg-savegame.delete #files
{
	margin-top: 4dp;
	height: 268dp;
}

body.dlg-savegame.save #files
{
	height: 224dp;
}

body.dlg-savegame #files .item
{
	height: 30dp;
	line-height: 28dp;
}

body.dlg-savegame .cell-description
{
	left: 11dp;
	width: 280dp;
	overflow: hidden;
	text-overflow: ellipsis;
}

body.dlg-savegame .cell-date
{
	left: 311dp;
}

body.dlg-savegame .cell-time
{
	left: 411dp;
}

body.dlg-savegame #files .item.unloadable
{
	color: var(--t-disabled-text, #5f5873);
	text-decoration: line-through;
}

body.dlg-savegame #description
{
	display: block;
	margin-top: 12dp;
	width: 490dp;
	height: 26dp;
	padding: 3dp 6dp;
}

body.dlg-savegame #buttons, body.dlg-savegame.save #buttons, body.dlg-savegame.delete #buttons
{
	margin-top: 16dp;
}

body.dlg-savegame #accept, body.dlg-savegame #cancel
{
	margin-left: 12dp;
	margin-right: 0;
}

body.dlg-savegame #accept
{
	margin-left: 0;
}

body.dlg-confirm #reveal
{
	width: 460dp;
	height: 188dp;
	margin-top: -94dp;
}

body.dlg-confirm #text
{
	height: 66dp;
	font-size: 15dp;
	line-height: 22dp;
	color: var(--t-text-hot, #ffffff);
}

body.dlg-confirm #buttons
{
	margin-top: 16dp;
}

body.dlg-confirm #ok, body.dlg-confirm #cancel
{
	margin-left: 12dp;
	margin-right: 0;
}

body.dlg-confirm #ok
{
	margin-left: 0;
}

body.dlg-message #reveal, body.dlg-message.net #reveal
{
	width: 480dp;
	height: 200dp;
	margin-top: -100dp;
}

body.dlg-message #text, body.dlg-message.net #text
{
	height: 88dp;
}

body.dlg-message #text p
{
	text-align: left;
	font-size: 15dp;
	line-height: 22dp;
	color: var(--t-text-hot, #ffffff);
}

body.dlg-message #buttons, body.dlg-message #buttons.alone, body.dlg-message.net #buttons, body.dlg-message.net #buttons.alone
{
	flex-direction: row-reverse;
	justify-content: flex-start;
	margin-top: 16dp;
}

body.dlg-message #buttons button, body.dlg-message.net #buttons button, body.dlg-message.net #buttons.alone button
{
	width: 120dp;
	margin: 0 0 0 12dp;
}

body.dlg-message #buttons button:first-child, body.dlg-message.net #buttons button:first-child
{
	margin-left: 0;
}

/* The mission browser. */
body.missionbrowser #list-caption
{
	margin: 0;
}

body.missionbrowser #missions
{
	margin-top: 10dp;
	height: 438dp;
}

body.missionbrowser #missions .item.header
{
	color: var(--t-text-hot, #ffffff);
	border-left-color: var(--t-edge-dim, #4d3d6b);
}

body.missionbrowser #missions .item.disabled
{
	color: var(--t-disabled-text, #5f5873);
}

body.missionbrowser #briefing
{
	background-color: var(--t-field-list, #0b0812a0);
}

body.missionbrowser #title
{
	color: var(--t-text-hot, #ffffff);
}

body.missionbrowser #buttons
{
	height: 40dp;
}

body.missionbrowser #difficulty-row
{
	display: flex;
	align-items: center;
	height: 40dp;
	line-height: 20dp;
}

body.missionbrowser #difficulty
{
	height: 26dp;
}

body.missionbrowser #back, body.missionbrowser #play
{
	height: 40dp;
}

body.lobby .trough
{
	z-index: 0;
}

/* The CnCNet page: a status card, one highlighted action, and the paths and edits folded under Details. The
   panel is as tall as its content. A state shows by its shape and its words: a filled circle with a tick is
   good, a square with "!" needs a step, a circle with "X" is missing. */
body.cncnet #backdrop
{
	display: flex;
	align-items: center;
	justify-content: center;
}

body.cncnet #reveal
{
	width: 640dp;
	height: auto;
	top: auto;
	margin: 0;
}

body.cncnet #chrome
{
	height: auto;
}

body.cncnet #wallpaper
{
	border-width: 1dp 1dp 1dp 3dp;
	border-color: var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-accent, #b46bff);
	border-radius: 2dp;
}

body.cncnet #content
{
	padding: 22dp 28dp 22dp 28dp;
}

body.cncnet #title
{
	height: 28dp;
	margin: 0 0 14dp 0;
	font-size: 16dp;
	line-height: 26dp;
	text-align: left;
	color: var(--t-muted, #a99bc9);
	border-bottom: 1dp var(--t-edge-dim, #4d3d6b);
}

body.cncnet .line
{
	font-size: 13dp;
	line-height: 18dp;
	margin: 0 0 4dp 0;
	white-space: normal;
}

body.cncnet #install, body.cncnet #plan
{
	display: none;
}

/* The status card */
body.cncnet #card
{
	display: block;
	margin-bottom: 10dp;
}

body.cncnet .stat
{
	display: flex;
	align-items: flex-start;
	padding: 6dp 0;
}

body.cncnet .stat-body
{
	flex: 1;
}

body.cncnet .stat-head
{
	font-size: 18dp;
	line-height: 26dp;
	color: var(--t-text-hot, #ffffff);
}

body.cncnet .stat-sub
{
	font-size: 14dp;
	line-height: 19dp;
	color: var(--t-muted, #a99bc9);
}

body.cncnet .mark
{
	display: block;
	position: relative;
	flex: none;
	box-sizing: border-box;
	width: 28dp;
	height: 28dp;
	margin: 0 14dp 0 0;
	border: 2dp var(--t-accent, #b46bff);
	text-align: center;
	font-size: 15dp;
	line-height: 24dp;
	color: var(--t-accent-strong, #d29bff);
}

body.cncnet .mark.ok
{
	border-radius: 14dp;
	background-color: var(--t-accent, #b46bff);
}

body.cncnet .mark.todo
{
	border-radius: 4dp;
}

body.cncnet .mark.bad
{
	border-radius: 14dp;
	color: var(--t-text-hot, #ffffff);
}

body.cncnet .tick
{
	position: absolute;
	left: 8dp;
	top: 3dp;
	width: 6dp;
	height: 12dp;
	border-width: 0 3dp 3dp 0;
	border-color: var(--t-ink, #05040a);
	transform: rotate(45deg);
}

/* Buttons: small ones in a row, and the highlighted one across the full width */
body.cncnet #actions
{
	margin-top: 4dp;
}

body.cncnet #actions button, body.cncnet #buttons button, body.cncnet #confirm button
{
	height: 32dp;
	margin: 0 8dp 8dp 0;
	padding: 8dp 16dp 0 16dp;
	font-size: 14dp;
	white-space: nowrap;
}

body.cncnet #actions button:active, body.cncnet #buttons button:active, body.cncnet #confirm button:active,
body.cncnet #actions button.disabled, body.cncnet #buttons button.disabled
{
	padding: 8dp 16dp 0 16dp;
}

body.cncnet #actions button.primary, body.cncnet #buttons button.primary
{
	width: 100%;
	height: 44dp;
	margin: 0 0 10dp 0;
	padding: 13dp 16dp 0 16dp;
	font-size: 17dp;
	color: var(--t-ink, #05040a);
	border-color: var(--t-accent-strong, #d29bff);
	decorator: vertical-gradient(var(--t-accent-strong, #d29bff) var(--t-accent, #b46bff));
}

body.cncnet #actions button.primary:hover, body.cncnet #buttons button.primary:hover
{
	color: var(--t-ink, #05040a);
	border-color: var(--t-text-hot, #ffffff);
	border-left-width: 1dp;
	padding-left: 16dp;
	decorator: vertical-gradient(var(--t-text-hot, #ffffff) var(--t-accent-strong, #d29bff));
}

body.cncnet #actions button.primary:active, body.cncnet #buttons button.primary:active
{
	padding: 14dp 16dp 0 16dp;
	decorator: vertical-gradient(var(--t-accent, #b46bff) var(--t-accent-strong, #d29bff));
}

body.cncnet #actions button.primary.disabled, body.cncnet #buttons button.primary.disabled
{
	padding: 13dp 16dp 0 16dp;
	color: var(--t-disabled-text, #5f5873);
	border-color: var(--t-disabled-edge, #2c2638);
	decorator: vertical-gradient(var(--t-disabled-top, #1c1825) var(--t-disabled-bottom, #141119));
}

body.cncnet #buttons
{
	flex-wrap: wrap;
	align-items: center;
	margin-top: 14dp;
}

body.cncnet #ok
{
	width: 88dp;
	margin: 0 0 8dp auto;
}

/* Progress and the status line */
body.cncnet #progress
{
	margin: 4dp 0 8dp 0;
}

body.cncnet progress
{
	height: 10dp;
}

body.cncnet #progresstext
{
	margin-top: 4dp;
	font-size: 13dp;
	line-height: 18dp;
	color: var(--t-muted, #a99bc9);
}

body.cncnet #status-row
{
	display: none;
	align-items: flex-start;
	margin: 4dp 0 8dp 0;
	padding: 8dp 12dp;
	border-left: 3dp var(--t-edge-dim, #4d3d6b);
	background-color: var(--t-field-list, #0b0812a0);
}

body.cncnet #status-row.has
{
	display: flex;
}

body.cncnet #status-row .mark
{
	width: 22dp;
	height: 22dp;
	margin-right: 12dp;
	font-size: 14dp;
	line-height: 18dp;
}

body.cncnet #status
{
	flex: 1;
	margin: 0;
	font-size: 14dp;
	line-height: 22dp;
	color: var(--t-text, #ece6f7);
}

body.cncnet #status.problem
{
	color: var(--t-text-hot, #ffffff);
}

body.cncnet #confirm
{
	margin: 0 0 8dp 0;
}

body.cncnet #confirmtext
{
	font-size: 14dp;
	line-height: 19dp;
}

/* Details */
body.cncnet #details-block
{
	display: block;
	margin-top: 4dp;
}

body.cncnet #details-toggle
{
	height: 28dp;
	margin: 0;
	padding: 6dp 14dp 0 14dp;
	font-size: 14dp;
}

body.cncnet #details-toggle:active
{
	padding: 6dp 14dp 0 14dp;
}

body.cncnet #details
{
	max-height: 150dp;
	margin-top: 8dp;
	padding: 8dp 12dp 4dp 12dp;
	overflow-y: auto;
	border: 1dp var(--t-edge-dim, #4d3d6b);
	background-color: var(--t-field, #0b0812d0);
}

body.cncnet .d-head
{
	margin: 6dp 0 4dp 0;
	font-size: 13dp;
	line-height: 18dp;
	color: var(--t-caption, #d9c8ff);
}

body.cncnet .d-row
{
	padding-left: 10dp;
	border-left: 2dp var(--t-rule, #2e2640);
}

/* The safe-play note */
body.cncnet #notes
{
	margin-top: 12dp;
	padding: 8dp 12dp 4dp 12dp;
	border-left: 3dp var(--t-edge-dim, #4d3d6b);
	background-color: var(--t-field-list, #0b0812a0);
}

body.cncnet #notes .line
{
	color: var(--t-muted, #a99bc9);
}

body.cncnet .label
{
	font-weight: normal;
	color: var(--t-text-hot, #ffffff);
}

/* The network lobby: the chat and the say field on the left, the games and the players on the right, and the
   buttons below. Every element keeps its place by an absolute position inside the panel. */
body.netlobby #backdrop #reveal
{
	width: 760dp;
	height: 536dp;
	top: 50%;
	margin-top: -268dp;
}

body.netlobby #wallpaper
{
	border-width: 1dp 1dp 1dp 3dp;
	border-color: var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-accent, #b46bff);
	border-radius: 2dp;
}

body.netlobby #title
{
	display: block;
	left: 28dp;
	top: 22dp;
	width: 704dp;
	height: 28dp;
	font-size: 16dp;
	line-height: 26dp;
	color: var(--t-muted, #a99bc9);
	border-bottom: 1dp var(--t-edge-dim, #4d3d6b);
}

body.netlobby .caption
{
	height: 20dp;
	line-height: 20dp;
	font-size: 14dp;
	color: var(--t-caption, #d9c8ff);
}

body.netlobby #cap-chat
{
	display: block;
}

body.netlobby #cap-name { left: 28dp; top: 66dp; height: 32dp; line-height: 32dp; }
body.netlobby #cap-chat { left: 28dp; top: 112dp; }
body.netlobby #cap-games { left: 492dp; top: 112dp; }
body.netlobby #cap-players { left: 492dp; top: 280dp; }

body.netlobby #handle
{
	left: 112dp;
	top: 66dp;
	width: 220dp;
	height: 32dp;
	padding: 0 10dp;
	font-size: 15dp;
	line-height: 30dp;
}

body.netlobby #say
{
	left: 28dp;
	top: 424dp;
	width: 440dp;
	height: 32dp;
	padding: 0 10dp;
	font-size: 14dp;
	line-height: 30dp;
}

body.netlobby #chat { left: 28dp; top: 136dp; width: 440dp; height: 280dp; }
body.netlobby #games { left: 492dp; top: 136dp; width: 240dp; height: 136dp; }
body.netlobby #players { left: 492dp; top: 304dp; width: 240dp; height: 152dp; }

body.netlobby .list
{
	background-color: var(--t-field, #0b0812d0);
	border-color: var(--t-edge-dim, #4d3d6b);
}

body.netlobby .list > .rows
{
	background-color: transparent;
}

body.netlobby .list .item
{
	height: 28dp;
	padding: 0 10dp;
	border-left: 3dp transparent;
	font-size: 14dp;
	line-height: 28dp;
}

body.netlobby #games .item:hover
{
	background-color: var(--t-face-bottom, #18131f);
}

body.netlobby #games .item.selected
{
	padding-left: 7dp;
	border-left: 3dp var(--t-accent, #b46bff);
}

body.netlobby #chat .line
{
	padding: 0 12dp;
	font-size: 14dp;
	line-height: 20dp;
}

body.netlobby #nogames
{
	display: block;
	margin: 6dp 10dp 0 10dp;
	font-size: 13dp;
	line-height: 18dp;
	color: var(--t-muted, #a99bc9);
}

body.netlobby #cancel, body.netlobby #join, body.netlobby #new
{
	top: 482dp;
	width: 132dp;
	height: 40dp;
	padding: 11dp 8dp 0 8dp;
	font-size: 16dp;
	text-align: center;
}

body.netlobby #cancel:active, body.netlobby #join:active, body.netlobby #new:active
{
	padding: 12dp 8dp 0 8dp;
}

body.netlobby #cancel { left: 28dp; }
body.netlobby #new { left: 456dp; }
body.netlobby #join { left: 600dp; }

body.netlobby #join
{
	color: var(--t-ink, #05040a);
	border-color: var(--t-accent-strong, #d29bff);
	decorator: vertical-gradient(var(--t-accent-strong, #d29bff) var(--t-accent, #b46bff));
}

body.netlobby #join:hover
{
	color: var(--t-ink, #05040a);
	border-color: var(--t-text-hot, #ffffff);
	decorator: vertical-gradient(var(--t-text-hot, #ffffff) var(--t-accent-strong, #d29bff));
}

body.netlobby #join:active
{
	decorator: vertical-gradient(var(--t-accent, #b46bff) var(--t-accent-strong, #d29bff));
}

/* The main menu shows the game's logo above its panel. titlelogo is cut from the installed title
   picture until a drawn logo replaces it; with a replaced picture it is empty. */
#logo
{
	display: none;
	position: absolute;
	left: 7%;
	top: 50%;
	width: 400dp;
	height: 128dp;
	margin: -314dp 0 0 -28dp;
	decorator: image(titlelogo fill);
	pointer-events: none;
}

body.titlemenu.main.live #logo
{
	display: block;
}
