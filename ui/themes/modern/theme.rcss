/* The modern menu style: Yuri's Revenge's title art behind dark, crisp panels. It restyles the
   shared kit and keeps every screen's layout. Sizes are in dp, laid out for 1280x720. */

body
{
	font-family: fullfnt;
	color: var(--t-text, #ece6f7);
}

/* Yuri's Revenge's title art fills the window behind the menus, dimmed. */
#screen-bg
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: -2;
	background-color: var(--t-ink, #05040a);
	pointer-events: none;
}

#screen-art
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image(GLSLMD.SHP@GLSMD.PAL cover center top);
}

#screen-shade
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(var(--t-shade-top, #0a061299) var(--t-shade-bottom, #05030ae6));
}

/* Over a game in progress the art gives way to a light shade, so the panel stands out from the
   battlefield. */
.ingame #screen-bg
{
	background-color: transparent;
}

.ingame #screen-art
{
	display: none;
}

.ingame #screen-shade
{
	background-color: #0000006c;
	decorator: none;
}

/* The menu battle shows through in place of the title art, under a shade dark enough for text. */
.live #screen-bg
{
	background-color: transparent;
}

.live #screen-art
{
	display: none;
}

.live #screen-shade
{
	background-color: #00000058;
	decorator: none;
}

/* On the title menus the shade darkens from the left, where the menu panel stands, and the battle
   stays clear on the right. */
#screen-vignette
{
	display: none;
	position: absolute;
	left: 0;
	top: 0;
	width: 60%;
	height: 100%;
	decorator: horizontal-gradient(#000000c0 #00000000);
}

body.titlemenu.live #screen-shade
{
	background-color: #00000018;
}

body.titlemenu.live #screen-vignette
{
	display: block;
}

/* The panel replaces Tiberian Sun's chrome: no side bars, glow or teal backdrop. */
#bar-left, #bar-right, #edge-left, #edge-right, #glow, #wallpaper-art,
.revealing #edge-left, .revealing #edge-right
{
	display: none;
}

#wallpaper
{
	background-color: var(--t-panel, #120d1ce8);
	border: 1dp var(--t-edge, #6b43a8);
	border-radius: 6dp;
}

/* Text */
.caption, .value
{
	color: var(--t-caption, #d9c8ff);
}

/* Buttons */
button, button.wide, button.tall
{
	height: 26dp;
	border: 1dp var(--t-edge-dim, #4d3d6b);
	border-radius: 3dp;
	padding: 4dp 8dp 0 8dp;
	color: var(--t-text, #ece6f7);
	background-color: transparent;
	decorator: vertical-gradient(var(--t-face-top, #2e2640) var(--t-face-bottom, #18131f));
}

button.tall
{
	height: 32dp;
	padding-top: 7dp;
}

button:hover, button.wide:hover, button.tall:hover
{
	border-color: var(--t-accent, #b46bff);
	color: var(--t-text-hot, #ffffff);
	decorator: vertical-gradient(var(--t-hover-top, #3d2f57) var(--t-hover-bottom, #1f1829));
}

button:active, button.wide:active, button.tall:active
{
	position: relative;
	top: 0;
	border: 1dp var(--t-accent-strong, #d29bff);
	padding: 5dp 8dp 0 8dp;
	decorator: vertical-gradient(var(--t-press-top, #1a1424) var(--t-press-bottom, #2a203a));
}

button.disabled, button:disabled, button.wide.disabled, button.wide:disabled, button.tall.disabled, button.tall:disabled,
button.disabled:active, button:disabled:active, button.wide.disabled:active, button.wide:disabled:active,
button.tall.disabled:active, button.tall:disabled:active
{
	position: relative;
	top: 0;
	border: 1dp var(--t-disabled-edge, #2c2638);
	padding: 4dp 8dp 0 8dp;
	color: var(--t-disabled-text, #5f5873);
	decorator: vertical-gradient(var(--t-disabled-top, #1c1825) var(--t-disabled-bottom, #141119));
}

.keys button:focus, .keys label.check:focus
{
	color: var(--t-text-hot, #ffffff);
	border-color: var(--t-accent-strong, #d29bff);
}

.keys button.disabled:focus
{
	color: var(--t-disabled-text, #5f5873);
}

/* Fields, lists and drop-down boxes */
input[type='range'], input[type='text'], input[type='password'], textarea, select, .hotkey, .list
{
	border-color: var(--t-edge-dim, #4d3d6b);
	background-color: var(--t-field, #0b0812d0);
}

.keys .list:focus, .keys select:focus, .keys input[type='range']:focus
{
	border-color: var(--t-accent-strong, #d29bff);
}

.list .item, select option
{
	color: var(--t-text, #ece6f7);
}

.list .item:checked, .list .item.selected, select option:checked
{
	background-color: var(--t-select, #4a2f78);
	color: var(--t-text-hot, #ffffff);
}

select selectbox
{
	background-color: var(--t-popup, #120d1c);
	border: 1dp var(--t-edge, #6b43a8);
}

/* Check boxes */
input[type='checkbox']
{
	border: 1dp var(--t-edge, #6b43a8);
	border-radius: 3dp;
	background-color: var(--t-field-solid, #0b0812);
	decorator: none;
}

input[type='checkbox']:checked
{
	background-color: var(--t-accent, #b46bff);
	decorator: none;
}

input[type='checkbox']:disabled
{
	border-color: var(--t-disabled-edge, #2c2638);
	background-color: var(--t-disabled-top, #1c1825);
	decorator: none;
}

input[type='checkbox']:checked:disabled
{
	border-color: var(--t-disabled-edge, #2c2638);
	background-color: var(--t-disabled-check, #5f4a80);
	decorator: none;
}

/* Sliders */
input[type='range'] slidertrack
{
	background-color: var(--t-track, #1c1528);
	decorator: none;
}

input[type='range'] sliderbar
{
	border-radius: 2dp;
	background-color: var(--t-accent, #b46bff);
	decorator: none;
}

/* Scroll bars */
scrollbarvertical
{
	border-left-color: var(--t-face-top, #2e2640);
}

scrollbarvertical slidertrack
{
	background-color: var(--t-field-solid, #0b0812);
	decorator: none;
}

scrollbarvertical sliderbar
{
	border-radius: 2dp;
	background-color: var(--t-edge-dim, #4d3d6b);
	decorator: none;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc,
scrollbarvertical sliderarrowdec:active, scrollbarvertical sliderarrowinc:active
{
	background-color: var(--t-face-top, #2e2640);
	decorator: none;
}

.tooltip
{
	background-color: var(--t-tooltip, #120d1cf0);
	border: 1dp var(--t-edge, #6b43a8);
	color: var(--t-text, #ece6f7);
}

/* Text everywhere in the vector face, a notch smaller than the bitmap font it replaces. */
body
{
	font-size: 14dp;
}

.sans, input[type='text'], input[type='password'], textarea, .list, .tooltip, .hotkey, .group > label, .group > .rule
{
	font-family: fullfnt;
	font-size: 14dp;
}

input[type='text'], input[type='password'], textarea, .hotkey, select, select option
{
	color: var(--t-text, #ece6f7);
	caret-color: var(--t-accent-strong, #d29bff);
}

input selection, textarea selection
{
	background-color: var(--t-select, #4a2f78);
	color: var(--t-text-hot, #ffffff);
}

select:disabled, select.disabled, .trough.disabled
{
	color: var(--t-disabled-text, #5f5873);
}

/* Value boxes, frames and group outlines */
.trough, .trough.disabled
{
	border: 1dp var(--t-edge-dim, #4d3d6b);
	background-color: var(--t-field, #0b0812d0);
	color: var(--t-text, #ece6f7);
	decorator: none;
}

.trough-edge, .trough-edge.disabled
{
	background-color: transparent;
}

.frame, .group, progress, select selectbox
{
	border-color: var(--t-edge-dim, #4d3d6b);
}

.group > .rule
{
	color: var(--t-caption, #d9c8ff);
}

.group > .rule > span
{
	background-color: var(--t-edge-dim, #4d3d6b);
}

progress fill
{
	background-color: var(--t-accent, #b46bff);
	decorator: horizontal-gradient(var(--t-edge, #6b43a8) var(--t-accent, #b46bff));
}

/* Arrows */
select selectarrow, select:disabled selectarrow, select.disabled selectarrow
{
	background-color: var(--t-face-top, #2e2640);
	decorator: image(arrow-down.png fill);
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowdec:active
{
	decorator: image(arrow-up.png fill);
}

scrollbarvertical sliderarrowinc, scrollbarvertical sliderarrowinc:active
{
	decorator: image(arrow-down.png fill);
}

/* The version and copyright in the bottom right corner of the main menu. */
#stamp
{
	position: absolute;
	right: 16dp;
	bottom: 10dp;
	width: 480dp;
	text-align: right;
	font-family: fullfnt;
	font-size: 12dp;
	line-height: 16dp;
	color: #e8e8e8d8;
	font-effect: shadow(1dp 1dp #000000);
	pointer-events: none;
}

/* The screen-edge frame: a tinted border round the window, over every screen. */
#frame
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	border: 4dp var(--t-frame, #6b43a8);
	pointer-events: none;
}

/* The profile panel at the top left of the title menus: the player's name over a smaller line. */
#profile
{
	display: none;
	position: absolute;
	left: 16dp;
	top: 16dp;
	width: 200dp;
	height: 50dp;
	padding: 6dp 10dp 0 10dp;
	background-color: var(--t-panel, #120d1ce8);
	border: 1dp var(--t-edge, #6b43a8);
	border-radius: 3dp;
	pointer-events: none;
}

#profile-name
{
	font-size: 16dp;
	line-height: 20dp;
	color: var(--t-text-hot, #ffffff);
}

#profile-line
{
	font-size: 11dp;
	line-height: 14dp;
	color: var(--t-muted, #a99bc9);
}

/* The version at the top right of the title menus. */
#emblem
{
	display: none;
	position: absolute;
	right: 16dp;
	top: 16dp;
	width: 180dp;
	height: 16dp;
	pointer-events: none;
}

#badge-version
{
	position: absolute;
	left: 0;
	top: 0;
	width: 180dp;
	height: 16dp;
	font-size: 12dp;
	line-height: 16dp;
	text-align: right;
	color: #e8e8e8d8;
	font-effect: shadow(1dp 1dp #000000);
}

body.titlemenu #profile, body.titlemenu #emblem
{
	display: block;
}

/* The title screen menus stand in one panel on the left, with the menu's name at the top and its
   buttons stacked below. The panel is as tall as its buttons need; the count-N class gives the number. */
body.titlemenu #backdrop #reveal
{
	width: 300dp;
	height: 366dp;
	top: 50%;
	margin: -183dp 0 0 7%;
}

body.titlemenu.count-4 #backdrop #reveal
{
	height: 270dp;
	margin-top: -135dp;
}

body.titlemenu.count-5 #backdrop #reveal
{
	height: 318dp;
	margin-top: -159dp;
}

/* The main menu has no caption: its buttons start at the top of the panel. */
body.titlemenu.main #backdrop #reveal
{
	height: 328dp;
	margin-top: -164dp;
}

body.titlemenu #wallpaper
{
	border-width: 1dp 1dp 1dp 3dp;
	border-color: var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-accent, #b46bff);
	border-radius: 2dp;
}

body.titlemenu #content
{
	padding: 66dp 0 0 0;
}

body.titlemenu.main #content
{
	padding-top: 24dp;
}

body.titlemenu #content > button
{
	position: static;
	display: block;
	width: 244dp;
	height: 40dp;
	margin: 0 auto 8dp auto;
	padding: 11dp 16dp 0 16dp;
	font-size: 16dp;
	text-align: left;
	border-radius: 2dp;
}

body.titlemenu #content > button:hover
{
	border-left-width: 4dp;
	padding-left: 19dp;
}

body.titlemenu #content > button:active
{
	padding: 12dp 16dp 0 16dp;
}

body.titlemenu #content > button.disabled, body.titlemenu #content > button:disabled
{
	padding: 11dp 16dp 0 16dp;
}

body.titlemenu #title
{
	display: block;
	position: absolute;
	left: 28dp;
	top: 22dp;
	width: 244dp;
	height: 28dp;
	font-size: 16dp;
	line-height: 26dp;
	text-align: left;
	color: var(--t-muted, #a99bc9);
	border-bottom: 1dp var(--t-edge-dim, #4d3d6b);
}

body.titlemenu.main #title
{
	display: none;
}

/* The skirmish lobby fills most of the screen: the player list on the left, the map and the game
   settings on the right. Its rows keep their order and the columns share the width. */
body.lobby #backdrop #reveal
{
	width: 1040dp;
	height: 572dp;
	top: 50%;
	margin-top: -286dp;
}

body.lobby #content
{
	padding: 24dp 28dp 0 28dp;
}

body.lobby #left
{
	width: 668dp;
	margin-right: 28dp;
}

body.lobby #right
{
	width: 288dp;
}

body.lobby #players
{
	padding: 10dp 12dp 8dp 12dp;
	background-color: var(--t-field-list, #0b0812a0);
	border-radius: 4dp;
}

body.lobby #headings
{
	height: 24dp;
}

body.lobby #headings > .caption
{
	height: 24dp;
	line-height: 24dp;
	font-size: 12dp;
	color: var(--t-muted, #a99bc9);
}

body.lobby .slot
{
	height: 42dp;
	border-top: 1dp var(--t-rule, #2e2640);
}

body.lobby .col-player { width: 196dp; margin-right: 8dp; }
body.lobby .col-side { width: 132dp; margin-right: 8dp; }
body.lobby .col-color { width: 128dp; margin-right: 8dp; }
body.lobby .col-start { width: 84dp; margin-right: 8dp; }
body.lobby .col-team { width: 72dp; }

body.lobby .cell
{
	height: 32dp;
}

body.lobby .chip
{
	width: 14dp;
	height: 20dp;
	margin-right: 6dp;
	border-radius: 2dp;
}

body.lobby .colour-name
{
	font-size: 13dp;
}

body.lobby #switches
{
	margin-top: 12dp;
	padding: 12dp 14dp 6dp 14dp;
}

body.lobby #map
{
	width: 288dp;
	height: 162dp;
}

body.lobby #preview
{
	width: 286dp;
	height: 160dp;
}

body.lobby #preview-caption
{
	width: 286dp;
	top: 68dp;
}

body.lobby #mapname
{
	width: 288dp;
	height: 22dp;
	margin-top: 8dp;
	line-height: 22dp;
}

body.lobby #pick
{
	width: 288dp;
	margin-top: 6dp;
}

body.lobby #settings
{
	width: 288dp;
	margin-top: 12dp;
	padding: 10dp 0 4dp 12dp;
}

body.lobby .setting
{
	height: 52dp;
}

body.lobby .setting input[type='range']
{
	width: 180dp;
}

body.lobby #notice
{
	height: 20dp;
	margin-top: 8dp;
	line-height: 20dp;
}

body.lobby #ok, body.lobby #cancel
{
	width: 136dp;
}

/* The Settings screen: a column of tabs down the left, with the page to its right. The whole screen is one
   translucent tinted backdrop, the .settings-backdrop class, so the game behind it shows through. The
   backdrop's colour and opacity are set in that one class; the tab column and the page sit on top of it. */
#tabs
{
	display: none;
}

.settings #tabs
{
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 200dp;
	padding: 16dp 12dp 0 12dp;
	background-color: var(--t-column, #0a0814e6);
	border-right: 1dp var(--t-column-edge, #3b2f55);
	z-index: 2;
}

#tabs button.tab
{
	display: block;
	width: 100%;
	height: 40dp;
	margin: 0 0 6dp 0;
	padding: 10dp 12dp 0 16dp;
	border: 1dp var(--t-edge-dim, #4d3d6b);
	border-radius: 4dp;
	text-align: left;
	color: var(--t-tab-text, #b9aad6);
	background-color: transparent;
	decorator: vertical-gradient(var(--t-tab-top, #2a2238) var(--t-face-bottom, #18131f));
}

#tabs button.tab.gone
{
	display: none;
}

#tabs button.tab:hover
{
	border-color: var(--t-accent, #b46bff);
	color: var(--t-text-hot, #ffffff);
	decorator: vertical-gradient(var(--t-hover-top, #3d2f57) var(--t-hover-bottom, #1f1829));
}

#tabs button.tab:active
{
	padding: 10dp 12dp 0 16dp;
	decorator: vertical-gradient(var(--t-press-top, #1a1424) var(--t-press-bottom, #2a203a));
}

/* The tab of the page on show has an accent bar at its left and joins the page. */
#tabs button.tab.active, #tabs button.tab.active:hover, #tabs button.tab.active:active
{
	border-color: var(--t-accent-strong, #d29bff);
	border-left-width: 5dp;
	color: var(--t-text-hot, #ffffff);
	background-color: var(--t-tab-active, #120d1c);
	decorator: none;
}

.keys #tabs button.tab:focus
{
	color: var(--t-text-hot, #ffffff);
	border-color: var(--t-accent-strong, #d29bff);
}

/* The backdrop: a translucent tinted fill over the whole screen, at about half opacity. Themes set
   the colour here, with the alpha byte last. The title art behind the menus stays out of the way. */
.settings-backdrop
{
	background-color: var(--t-backdrop, #0a0814cc);
}

.settings-backdrop #screen-bg
{
	display: none;
}

.settings-backdrop #wallpaper
{
	background-color: transparent;
	border: 0dp #00000000;
}

.settings #buttons > #sound, .settings #buttons > #keyboard
{
	display: none;
}

/* Wait notices ("Loading...", "Saving...") are a slim panel with the accent edge of the title menus;
   one without a progress bar is a single line tall. */
body.waitbox #wallpaper
{
	border-width: 1dp 1dp 1dp 3dp;
	border-color: var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-edge-dim, #4d3d6b) var(--t-accent, #b46bff);
	border-radius: 2dp;
}

body.waitbox #text
{
	font-size: 16dp;
	line-height: 20dp;
	color: var(--t-text-hot, #ffffff);
}

body.waitbox.nobar #backdrop #reveal
{
	width: 300dp;
	height: 64dp;
	margin-top: -32dp;
}

body.waitbox.nobar #content
{
	padding: 22dp 20dp 0 20dp;
}

body.waitbox.nobar #text
{
	height: 20dp;
}
