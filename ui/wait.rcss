#reveal
{
	width: 327dp;
	height: 105dp;
	top: 50%;
	margin-top: -52dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

#text
{
	height: 38dp;
	line-height: 17dp;
	text-align: center;
	white-space: pre-wrap;
}

#bar
{
	width: 150dp;
	height: 24dp;
	margin: 4dp auto 0 auto;
}


/* The loading notice leaves the loading picture or the menu backdrop under it in view. */
body.clear #screen-bg
{
	background-color: transparent;
}

body.clear #screen-art, body.clear #screen-shade, body.clear #screen-vignette, body.clear #frame
{
	display: none;
}

/* Over a loading picture the notice sits in the lower part of the screen, clear of the picture's middle. */
body.clear #reveal
{
	top: 80%;
}
