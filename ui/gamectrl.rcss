/* The game controls page. The layout is in settings.rcss. The Sound and Keyboard buttons only show
   in a game, and the Settings tabs hide them because the tabs replace them. */

#buttons
{
	display: flex;
	margin-top: 14dp;
}

#buttons button
{
	width: 140dp;
	margin-right: 8dp;
}

selectbox
{
	background-color: #0a0615;
}
