<rml>
<head>
	<title>Sound options</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="settings.rcss"/>
	<link type="text/rcss" href="sound.rcss"/>
</head>
<body template="dialog" class="page-settings settings-backdrop" data-model="sound" data-class-lite="!ingame">
	<div id="page">
		<div id="list">
			<p class="section">Volume</p>
			<div class="setting slider-row" id="row-score" desc="The volume of the background music."><span class="caption">Music Volume</span>
				<input type="range" id="score" min="0" max="10" step="1" data-attr-value="score" data-attrif-disabled="!enabled" data-event-change="queue('score', ev.value)"/><span class="value">{{score}}</span>
			</div>
			<div class="setting slider-row" id="row-sound" desc="The volume of the sound effects, such as weapons and explosions."><span class="caption">Sound Volume</span>
				<input type="range" id="sound" min="0" max="10" step="1" data-attr-value="sound" data-attrif-disabled="!enabled" data-event-change="queue('sound', ev.value)"/><span class="value">{{sound}}</span>
			</div>
			<div class="setting slider-row" id="row-voice" desc="The volume of the EVA announcements and spoken taunts."><span class="caption">EVA</span>
				<input type="range" id="voice" min="0" max="10" step="1" data-attr-value="voice" data-attrif-disabled="!enabled" data-event-change="queue('voice', ev.value)"/><span class="value">{{voice}}</span>
			</div>
			<div class="setting slider-row" id="row-unit" desc="The volume of unit and building replies, such as selection acknowledgements and death cries."><span class="caption">Unit voices</span>
				<input type="range" id="unit" min="0" max="10" step="1" data-attr-value="unit" data-attrif-disabled="!enabled" data-event-change="queue('unit', ev.value)"/><span class="value">{{unit}}</span>
			</div>
			<div class="setting slider-row" id="row-movie" desc="The volume of movies, such as briefings, cutscenes and the intro."><span class="caption">Movies</span>
				<input type="range" id="movie" min="0" max="10" step="1" data-attr-value="movie" data-attrif-disabled="!enabled" data-event-change="queue('movie', ev.value)"/><span class="value">{{movie}}</span>
			</div>

			<div id="music" data-if="ingame">
				<p class="section">Music</p>
				<div class="setting" id="music-buttons-row" desc="Starts or stops the music that is playing now.">
					<span class="caption">Playback</span>
					<div id="music-buttons">
						<button id="play" data-event-click="queue('play')">Play</button>
						<button id="stop" data-event-click="queue('stop')">Stop</button>
					</div>
				</div>
				<label class="check setting" id="switch-shuffle" desc="Plays the tracks in a random order."><span class="caption">Shuffle</span><input type="checkbox" id="shuffle" data-attrif-checked="shuffle" data-attrif-disabled="!enabled" data-event-click="queue('shuffle', shuffle ? 0 : 1)"/></label>
				<label class="check setting" id="switch-repeat" desc="Starts the list again when the last track ends."><span class="caption">Repeat</span><input type="checkbox" id="repeat" data-attrif-checked="repeat" data-attrif-disabled="!enabled" data-event-click="queue('repeat', repeat ? 0 : 1)"/></label>
				<div id="tracks" class="list" data-attrif-disabled="!enabled"><div class="rows">
					<div class="item track" data-for="track : tracks" data-class-selected="it_index == selected" data-event-click="queue('select', it_index)">{{track.label}}</div>
				</div></div>
			</div>
		</div>
		<div id="side">
			<p id="side-title">Description</p>
			<p id="description">Point at a setting or select it to read what it does.</p>
		</div>
	</div>
	<div id="footer">
		<button id="footer-reset" class="big" data-event-click="queue('reset')">Reset to defaults</button>
		<span id="footer-spacer"></span>
		<button id="footer-cancel" class="big" data-event-click="queue('cancel')">Back</button>
		<button id="footer-ok" class="big primary" data-event-click="queue('ok')">[[TXT_OK]]</button>
	</div>
</body>
</rml>
