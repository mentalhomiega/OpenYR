/* The Controls page. The command list takes the width left of the editor, and each key column is wide
   enough for the longest binding, such as "Ctrl+Shift+Alt+F12". The layout frame is in settings.rcss.
   Sizes are in dp. */

#list
{
	display: flex;
	flex-direction: column;
	overflow: hidden;
	padding: 12dp 16dp 12dp 20dp;
}

#filters
{
	display: flex;
	flex: 0 0 auto;
	height: 46dp;
}

.field
{
	margin-right: 12dp;
}

#scheme-field
{
	width: 230dp;
}

#search-field
{
	flex: 1 1 auto;
	min-width: 160dp;
}

#category-field
{
	width: 250dp;
	margin-right: 0;
}

#scheme,
#categories,
#search
{
	display: block;
	width: 100%;
	margin-top: 3dp;
}

.field .caption
{
	height: 16dp;
	line-height: 16dp;
}

/* The key columns: a command name takes the rest of the row, and each slot holds the widest binding. */
.head-row
{
	display: flex;
	flex: 0 0 auto;
	height: 24dp;
	margin-top: 12dp;
	padding: 0 8dp;
	line-height: 24dp;
}

.head-row .cmd-head
{
	flex: 1 1 auto;
	min-width: 0;
}

.head-row .slot-head
{
	flex: 0 0 230dp;
	width: 230dp;
}

#commands
{
	flex: 1 1 auto;
	min-height: 0;
	margin-top: 4dp;
}

#commands .item
{
	height: 28dp;
	line-height: 28dp;
	padding: 0 8dp;
}

.cmd-row
{
	display: flex;
	height: 28dp;
	white-space: nowrap;
}

.cmd-name
{
	flex: 1 1 auto;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
}

.slot
{
	flex: 0 0 230dp;
	width: 230dp;
	overflow: hidden;
	text-overflow: ellipsis;
}

#list-footer
{
	display: flex;
	flex: 0 0 auto;
	margin-top: 10dp;
}

#reset-category
{
	width: 180dp;
	white-space: nowrap;
}

/* The editor for the command chosen in the list, wide enough for the capture box and trigger side by side. */
#side
{
	flex: 0 0 340dp;
	width: 340dp;
}

#editor-name
{
	height: 24dp;
	line-height: 24dp;
	overflow: hidden;
}

#editor-hint
{
	line-height: 20dp;
}

#description
{
	min-height: 40dp;
	line-height: 19dp;
}

#capture-row
{
	display: flex;
	margin-top: 12dp;
	height: 30dp;
}

#capture
{
	display: inline-block;
	width: 170dp;
	height: 30dp;
	white-space: nowrap;
	overflow: hidden;
	tab-index: auto;
}

#capture span
{
	focus: none;
}

#capture .prompt
{
	color: #8a8a8a;
}

#trigger
{
	width: 120dp;
	margin-left: 8dp;
}

#editor-buttons
{
	display: flex;
	margin-top: 12dp;
}

#assign
{
	width: 120dp;
	margin-right: 8dp;
}

#clear
{
	width: 120dp;
}

#conflict
{
	margin-top: 14dp;
}

#conflict-text
{
	min-height: 40dp;
}

#conflict-buttons
{
	display: flex;
	margin-top: 6dp;
}

#swap
{
	width: 120dp;
	margin-right: 8dp;
}

#dismiss
{
	width: 120dp;
}

#notice
{
	margin-top: 12dp;
	line-height: 18dp;
}

selectbox
{
	background-color: #0a0615;
}
