#reveal
{
	width: 600dp;
	height: 424dp;
	top: 50%;
	margin-top: -212dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

#title
{
	height: 15dp;
	line-height: 15dp;
	text-align: center;
}

#top-row
{
	display: flex;
	margin-top: 6dp;
	height: 40dp;
}

.field
{
	margin-right: 10dp;
}

#scheme-field
{
	width: 196dp;
}

#search-field
{
	width: 132dp;
}

#category-field
{
	width: 150dp;
	margin-right: 0;
}

#scheme-field .caption,
#search-field .caption,
#category-field .caption
{
	height: 14dp;
	line-height: 14dp;
}

#scheme,
#categories
{
	display: block;
	width: 100%;
	margin-top: 3dp;
}

#search
{
	display: block;
	width: 100%;
	margin-top: 3dp;
}

#columns
{
	display: flex;
	margin-top: 8dp;
	height: 250dp;
}

#left
{
	width: 316dp;
	margin-right: 10dp;
}

#right
{
	width: 208dp;
}

.head-row
{
	display: flex;
	height: 14dp;
	line-height: 14dp;
}

.head-row .cmd-head
{
	width: 130dp;
}

.head-row .slot-head
{
	width: 80dp;
	text-align: center;
}

#commands
{
	margin-top: 3dp;
	height: 232dp;
}

#commands .item
{
	height: 17dp;
	line-height: 17dp;
	padding: 0 2dp;
}

.cmd-row
{
	display: flex;
	height: 17dp;
	white-space: nowrap;
}

.cmd-name
{
	width: 130dp;
	overflow: hidden;
}

.slot
{
	width: 80dp;
	height: 17dp;
	text-align: center;
	overflow: hidden;
}

.caption
{
	display: block;
	height: 15dp;
	line-height: 15dp;
}

#editor-name
{
	height: 16dp;
	line-height: 16dp;
	overflow: hidden;
}

#description
{
	height: 60dp;
	overflow: hidden;
}

#capture-row
{
	display: flex;
	margin-top: 4dp;
	height: 24dp;
}

#capture
{
	display: inline-block;
	width: 112dp;
	height: 24dp;
	white-space: nowrap;
	overflow: hidden;
	tab-index: auto;
}

#capture span
{
	focus: none;
}

#capture .prompt
{
	color: #8a8a8a;
}

#trigger
{
	width: 90dp;
	margin-left: 6dp;
}

#editor-buttons
{
	display: flex;
	margin-top: 8dp;
}

#assign
{
	width: 96dp;
	margin-right: 6dp;
}

#clear
{
	width: 96dp;
}

#conflict
{
	margin-top: 10dp;
}

#conflict-text
{
	height: 46dp;
	overflow: hidden;
}

#conflict-buttons
{
	display: flex;
	margin-top: 4dp;
}

#swap
{
	width: 96dp;
	margin-right: 6dp;
}

#dismiss
{
	width: 96dp;
}

#notice
{
	margin-top: 4dp;
	height: 14dp;
	line-height: 14dp;
	overflow: hidden;
	white-space: nowrap;
}

#buttons
{
	display: flex;
	margin-top: 6dp;
}

#reset-category
{
	width: 120dp;
	margin-right: 8dp;
}

#reset-all
{
	width: 96dp;
	margin-right: 0;
}

#ok
{
	width: 76dp;
	margin-left: 150dp;
	margin-right: 8dp;
}

#cancel
{
	width: 76dp;
}
