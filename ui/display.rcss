#reveal
{
	width: 600dp;
	height: 424dp;
	top: 50%;
	margin-top: -212dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

.heading
{
	padding-right: 1dp;
	line-height: 17dp;
	text-align: center;
}

#title
{
	height: 15dp;
}

#columns
{
	display: flex;
	margin-top: 7dp;
	height: 329dp;
}

#left
{
	width: 278dp;
}

#right
{
	width: 232dp;
	margin-left: 24dp;
}

#modes-label, #window-label
{
	height: 17dp;
}

#modes
{
	margin-top: 2dp;
	height: 179dp;
}

.row
{
	display: flex;
	margin-top: 5dp;
	height: 24dp;
}

#scale-row
{
	margin-top: 8dp;
}

.caption
{
	width: 132dp;
	line-height: 24dp;
}

#scale-row .caption
{
	width: 150dp;
}

select
{
	width: 100dp;
}

#scale
{
	width: 95dp;
}

.check
{
	display: block;
	margin-top: 3dp;
}

#switch-stretch, #switch-fullscreen
{
	margin-top: 8dp;
}

#pointer-label, #renderer-label
{
	margin-top: 10dp;
	height: 17dp;
}

#switch-system-cursor
{
	margin-top: 4dp;
}

#renderer-note
{
	margin-top: 3dp;
	line-height: 17dp;
}

#buttons
{
	display: flex;
	margin-top: 9dp;
}

button
{
	width: 94dp;
}

#ok
{
	margin-left: 137dp;
}

#cancel
{
	margin-left: 46dp;
}

selectbox
{
	background-color: #0a0615;
}
