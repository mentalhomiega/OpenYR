#reveal
{
	width: 600dp;
	height: 424dp;
	top: 50%;
	margin-top: -212dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

.heading
{
	padding-right: 1dp;
	line-height: 17dp;
	text-align: center;
}

#title
{
	height: 15dp;
}

#columns
{
	display: flex;
	margin-top: 7dp;
	height: 329dp;
}

#left
{
	width: 278dp;
}

#right
{
	width: 232dp;
	margin-left: 24dp;
}

#modes-label, #window-label
{
	height: 17dp;
}

#modes-row
{
	display: flex;
	margin-top: 2dp;
	height: 150dp;
}

#modes
{
	width: 130dp;
	height: 150dp;
}

.row
{
	display: flex;
	margin-top: 5dp;
	height: 24dp;
}

#scale-row
{
	margin-top: 8dp;
}

.caption
{
	width: 132dp;
	line-height: 24dp;
}

#scale-row .caption
{
	width: 150dp;
}

select
{
	width: 100dp;
}

#scale
{
	width: 95dp;
}

.check
{
	display: block;
	margin-top: 3dp;
}

#switch-stretch, #switch-fullscreen
{
	margin-top: 8dp;
}

#pointer-label, #renderer-label
{
	margin-top: 10dp;
	height: 17dp;
}

#switch-system-cursor
{
	margin-top: 4dp;
}

/* The Sidebar rows drop-down is disabled, and its label greyed, while the modern interface is off. */
#rows-row.disabled .caption
{
	color: #6a6388;
}

#renderer-note
{
	margin-top: 3dp;
	line-height: 17dp;
}

/* The mock screen stands beside the resolution list; its frame is set by setting-preview.rcss. */
#panel-preview
{
	margin-left: 10dp;
}

/* The pieces of the build panel mock, placed by the markup in display.rml. */
.mock-screen
{
	background-color: #342d63;
}

.mock-panel
{
	background-color: #0b0816;
}

.mock-top
{
	background-color: #4a3f86;
}

.mock-well
{
	background-color: #140f28;
}

.mock-fill
{
	background-color: #9d8ae6;
}

.mock-tab
{
	background-color: #6e5fb0;
}

.mock-cell
{
	background-color: #a897e8;
}

.mock-arrow
{
	background-color: #d6ccff;
}

#buttons
{
	display: flex;
	margin-top: 9dp;
}

button
{
	width: 94dp;
}

#ok
{
	margin-left: 137dp;
}

#cancel
{
	margin-left: 46dp;
}

selectbox
{
	background-color: #0a0615;
}
