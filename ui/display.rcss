#reveal
{
	width: 600dp;
	height: 424dp;
	top: 50%;
	margin-top: -212dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

.heading
{
	padding-right: 1dp;
	line-height: 17dp;
	text-align: center;
}

#title
{
	height: 15dp;
}

#columns
{
	display: flex;
	margin-top: 7dp;
	height: 329dp;
}

#left
{
	width: 278dp;
}

#right
{
	width: 232dp;
	margin-left: 24dp;
}

#modes-label, #window-label
{
	height: 17dp;
}

#modes-row
{
	display: flex;
	margin-top: 2dp;
	height: 150dp;
}

#modes
{
	width: 172dp;
	height: 150dp;
}

.row
{
	display: flex;
	margin-top: 5dp;
	height: 24dp;
}

#scale-row
{
	margin-top: 8dp;
}

.caption
{
	width: 132dp;
	line-height: 24dp;
}

#scale-row .caption
{
	width: 150dp;
}

select
{
	width: 100dp;
}

#scale
{
	width: 95dp;
}

.check
{
	display: block;
	margin-top: 3dp;
}

#switch-stretch, #switch-fullscreen
{
	margin-top: 8dp;
}

#pointer-label, #renderer-label
{
	margin-top: 10dp;
	height: 17dp;
}

#switch-system-cursor
{
	margin-top: 4dp;
}

#renderer-note
{
	margin-top: 3dp;
	line-height: 17dp;
}

/* The preview stands beside the resolution list, as tall as the list. */
#panel-preview
{
	display: flex;
	margin-left: 12dp;
	height: 150dp;
}

#preview-tabs
{
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	width: 12dp;
	height: 100%;
	margin-right: 6dp;
}

.preview-tab
{
	display: block;
	width: 12dp;
	height: 10dp;
	background-color: #2a2148;
}

#preview-body
{
	height: 100%;
	padding: 4dp;
	background-color: #120d24;
}

.preview-row
{
	display: flex;
	margin-bottom: 2dp;
}

.preview-cell
{
	display: block;
	width: 20dp;
	height: 100%;
	margin-right: 2dp;
	background-color: #06040e;
}

#preview-arrows
{
	display: flex;
	margin-top: 2dp;
	height: 10dp;
}

.preview-arrow
{
	display: block;
	width: 20dp;
	height: 10dp;
	margin-right: 2dp;
	background-color: #3c2f66;
}

#buttons
{
	display: flex;
	margin-top: 9dp;
}

button
{
	width: 94dp;
}

#ok
{
	margin-left: 137dp;
}

#cancel
{
	margin-left: 46dp;
}

selectbox
{
	background-color: #0a0615;
}
