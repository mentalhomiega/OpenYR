#reveal
{
	width: 344dp;
	height: 398dp;
	top: 50%;
	margin-top: -199dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

.heading
{
	padding-right: 1dp;
	line-height: 17dp;
	text-align: center;
}

#title
{
	height: 15dp;
}

#modes-label
{
	margin-top: 7dp;
	height: 17dp;
}

#modes
{
	margin-top: 2dp;
	height: 179dp;
}

#scale-row
{
	display: flex;
	margin-top: 8dp;
	height: 24dp;
}

#scale-label
{
	width: 150dp;
	line-height: 24dp;
}

#scale
{
	width: 95dp;
}

#switch-stretch
{
	margin-top: 8dp;
}

#switch-system-cursor, #switch-classic-menus
{
	margin-top: 3dp;
}

#buttons
{
	display: flex;
	margin-top: 9dp;
}

button
{
	width: 94dp;
}

#cancel
{
	margin-left: 90dp;
}

#scale selectbox
{
	background-color: #0a0615;
}
