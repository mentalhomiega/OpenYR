<rml>
<head>
	<title>Customize keyboard</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="keyboard.rcss"/>
</head>
<body template="dialog" data-model="keyboard">
	<p class="heading" id="title">Customize Keyboard</p>
	<div id="top-row">
		<div class="field" id="scheme-field"><span class="caption">Control scheme:</span>
			<select id="scheme" data-value="scheme" data-event-change="queue('scheme', ev.value)">
				<option value="0">Classic (Yuri's Revenge)</option>
				<option value="1">Modern</option>
			</select>
		</div>
		<div class="field" id="search-field"><span class="caption">Search:</span>
			<input type="text" id="search" maxlength="32" data-value="search" data-event-change="queue('search', 0, ev.value)"/>
		</div>
		<div class="field" id="category-field"><span class="caption">Category:</span>
			<select id="categories" data-value="categoryindex" data-event-change="queue('category', ev.value)">
				<option data-for="name : categories" data-attr-value="it_index">{{name}}</option>
			</select>
		</div>
	</div>
	<div id="columns">
		<div id="left">
			<div class="head-row"><span class="caption cmd-head">Command</span><span class="caption slot-head">Primary</span><span class="caption slot-head">Secondary</span></div>
			<div id="commands" class="list"><div class="rows">
				<div class="item" data-for="row : rows" data-class-selected="row.command == selected">
					<div class="cmd-row">
						<span class="cmd-name" data-event-click="queue('pick', row.pick0)">{{row.name}}</span>
						<span class="slot" data-event-click="queue('pick', row.pick0)">{{row.slot0}}</span>
						<span class="slot" data-event-click="queue('pick', row.pick1)">{{row.slot1}}</span>
					</div>
				</div>
			</div></div>
		</div>
		<div id="right">
			<p class="caption" id="editor-name" data-if="selected >= 0">{{selectedname}}</p>
			<p class="caption" id="editor-hint" data-if="selected < 0">Choose a command, then a slot.</p>
			<p id="description">{{description}}</p>
			<p class="caption" data-if="selected >= 0 && slot == 0">Primary key:</p>
			<p class="caption" data-if="selected >= 0 && slot == 1">Secondary key:</p>
			<div id="capture-row" data-if="selected >= 0">
				<div id="capture" class="hotkey"><span data-if="capturedname != ''">{{capturedname}}</span><span class="prompt" data-if="capturedname == ''">Press a key</span></div>
				<select id="trigger" data-value="trigger" data-event-change="queue('trigger', ev.value)">
					<option value="0">Press</option>
					<option value="1">Double press</option>
					<option value="2">Hold</option>
					<option value="3">While held</option>
				</select>
			</div>
			<div id="editor-buttons" data-if="selected >= 0">
				<button id="assign" data-event-click="queue('assign')">Assign</button>
				<button id="clear" data-event-click="queue('clear')">Clear</button>
			</div>
			<div id="conflict" data-if="conflict != ''">
				<p id="conflict-text">{{conflict}}</p>
				<div id="conflict-buttons">
					<button id="swap" data-event-click="queue('swap')">Swap</button>
					<button id="dismiss" data-event-click="queue('dismiss')">Cancel</button>
				</div>
			</div>
		</div>
	</div>
	<p id="notice">{{notice}}</p>
	<div id="buttons">
		<button id="reset-category" data-event-click="queue('resetcategory')">Reset category</button>
		<button id="reset-all" data-event-click="queue('resetall')">Reset all</button>
		<button id="ok" data-event-click="queue('ok')">[[TXT_OK]]</button>
		<button id="cancel" data-event-click="queue('cancel')">[[TXT_CANCEL]]</button>
	</div>
</body>
</rml>
