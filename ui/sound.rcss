/* The audio page. The layout is in settings.rcss; the music area lists its tracks below the switches. */

#music-buttons
{
	display: flex;
}

#music-buttons button
{
	width: 110dp;
	margin-left: 8dp;
}

#tracks
{
	height: 220dp;
	margin-top: 8dp;
}

#tracks .item.track
{
	height: 26dp;
	line-height: 26dp;
	padding: 0 8dp;
}

selectbox
{
	background-color: #0a0615;
}
