/* The mission browser's layout. Colors come from the kit and the theme, so a theme restyles this screen with the rest.
   Sizes are in dp, laid out for 1280x720. */

body.missionbrowser #backdrop #reveal
{
	width: 1200dp;
	height: 620dp;
	top: 50%;
	margin-top: -310dp;
}

body.missionbrowser #content
{
	padding: 22dp 28dp 0 28dp;
}

#columns
{
	display: flex;
	height: 500dp;
}

#list-column
{
	width: 380dp;
	height: 500dp;
	margin-right: 20dp;
	padding: 10dp;
}

#list-caption
{
	display: block;
	height: 20dp;
	line-height: 20dp;
	font-size: 14dp;
}

#missions
{
	margin-top: 8dp;
	height: 466dp;
}

#missions .item
{
	height: 22dp;
	line-height: 20dp;
	padding-left: 8dp;
	font-size: 14dp;
	white-space: nowrap;
	overflow: hidden;
}

#missions .item.header
{
	margin-top: 6dp;
	font-size: 14dp;
}

#info-column
{
	width: 720dp;
	height: 500dp;
}

#top
{
	display: flex;
	height: 216dp;
}

#map
{
	width: 384dp;
	height: 216dp;
	padding: 1dp;
}

#map #preview
{
	width: 382dp;
	height: 214dp;
}

#map
{
	position: relative;
}

#map-empty
{
	position: absolute;
	left: 0;
	right: 0;
	top: 96dp;
	text-align: center;
	line-height: 24dp;
	font-size: 15dp;
}

#summary
{
	width: 316dp;
	margin-left: 20dp;
}

#subtitle
{
	display: block;
	height: 18dp;
	line-height: 18dp;
	font-size: 13dp;
}

#title
{
	display: block;
	height: 28dp;
	line-height: 28dp;
	font-size: 20dp;
	overflow: hidden;
}

#mapname
{
	display: block;
	height: 18dp;
	line-height: 18dp;
	font-size: 13dp;
}

#notice
{
	display: block;
	margin-top: 14dp;
	line-height: 18dp;
	font-size: 14dp;
	white-space: normal;
}

#briefing
{
	margin-top: 16dp;
	height: 268dp;
	padding: 10dp 12dp;
	overflow-y: auto;
}

#briefing-text
{
	white-space: pre-wrap;
	line-height: 19dp;
	font-size: 15dp;
}

#buttons
{
	display: flex;
	margin-top: 14dp;
	height: 34dp;
}

#difficulty-row
{
	width: 420dp;
	height: 34dp;
	line-height: 34dp;
}

#difficulty-caption
{
	width: 120dp;
}

#difficulty
{
	width: 240dp;
	height: 30dp;
}

#actions
{
	margin-left: auto;
}

#back, #play
{
	width: 150dp;
	height: 34dp;
}

#play
{
	margin-left: 12dp;
}
